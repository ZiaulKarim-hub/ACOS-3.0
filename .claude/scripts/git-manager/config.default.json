{
  "roots": [
    "/Users/zee/Documents/Vibe Coding",
    "/Users/zee/Documents/OKOA",
    "/Users/zee/.claude"
  ],
  "maxDepth": 3,
  "skipDirs": [
    "node_modules",
    ".venv",
    "venv",
    "__pycache__",
    ".next",
    ".nuxt",
    "dist",
    "build",
    "out",
    ".cache",
    "target",
    ".Trash",
    "Library",
    ".git",
    "vendor",
    "Pods",
    ".pytest_cache",
    ".mypy_cache",
    "coverage",
    ".turbo",
    ".parcel-cache",
    "site-packages"
  ],
  "ignorePaths": [],
  "watchIgnore": [
    "/.claude/projects/",
    "/.claude/sessions/",
    "/.claude/session-env/",
    "/.claude/shell-snapshots/",
    "/.claude/file-history/",
    "/.claude/paste-cache/",
    "/.claude/cache/",
    "/.claude/telemetry/",
    "/.claude/todos/",
    "/.claude/tasks/",
    "/.claude/statsig/",
    "/.acos/state/",
    "/.acos/evidence/"
  ],
  "ignoreNames": [
    "_build",
    "rebuild",
    "swarm-output",
    "build (reproducible source)",
    "_generated",
    "_extract"
  ],
  "accounts": {
    "personal": {
      "label": "ZiaulKarim-hub (personal)",
      "match": ["github.com-personal", "ZiaulKarim-hub"]
    },
    "work": {
      "label": "okoateam (work)",
      "match": ["github.com-okoateam", "okoateam"]
    }
  },
  "neverPush": [
    {
      "repoMatch": "FruitSync",
      "forbidAccount": "work",
      "reason": "FruitSync is PERSONAL and must NEVER reach okoateam (standing rule, ~/CLAUDE.md)"
    }
  ]
}
