{
  "skill_version": "1.1.0",
  "skill_name": "acos-dataroom",
  "skill_role": "Outbound diligence data room preparation for OKOA Capital",
  "production_ready": true,

  "checklist_master_reference_path": "/Users/zee/okoa-labs/okoa_ops/.claude/data/dd-checklist-template.md",
  "checklist_master_reference_role": "category_vocabulary_supplement",
  "checklist_internal_directory": "references/",
  "deal_type_checklist_files": {
    "loan_sale": "references/checklist_loan_sale.md",
    "loan_participation": "references/checklist_loan_participation.md",
    "property_sale": "references/checklist_property_sale.md",
    "foreclosure_auction": "references/checklist_foreclosure_auction.md",
    "lender_package": "references/checklist_lender_package.md"
  },
  "deal_type_taxonomy_files": {
    "loan_sale": "references/taxonomy_loan_sale.md",
    "loan_participation": "references/taxonomy_loan_participation.md",
    "property_sale": "references/taxonomy_property_sale.md",
    "foreclosure_auction": "references/taxonomy_foreclosure.md",
    "lender_package": "references/taxonomy_lender_package.md"
  },

  "deal_types": [
    "loan_sale",
    "loan_participation",
    "property_sale",
    "foreclosure_auction",
    "lender_package"
  ],

  "include_status_enum": [
    "include",
    "include_after_redaction",
    "internal_only_pii",
    "internal_only_privileged",
    "internal_only_strategic",
    "superseded",
    "absent",
    "review"
  ],

  "default_sensitivity_mode": "high",
  "default_ocr_required": true,
  "default_vision_fallback": true,
  "default_allow_upload": false,
  "default_allow_file_renaming": false,
  "ocr_confidence_threshold": 0.70,
  "verbose_logging": true,
  "log_confidence_below": 0.85,

  "system_files_excluded": [".DS_Store", "Thumbs.db", "~$*", "desktop.ini", ".localized"],
  "default_excluded_extensions": [".eml", ".msg", ".mbox", ".zip", ".tar", ".gz", ".7z", ".rar"],

  "output_subfolder": "_acos_dataroom_output",
  "output_subdirectories": {
    "extraction": "extraction",
    "evidence": "evidence",
    "intermediate": "intermediate",
    "logs": "logs"
  },

  "language": "en",
  "currency": "USD",

  "vision_bridge": {
    "subdirectory": "vision_bridge",
    "default_mode": "batch",
    "blocking_timeout_seconds": 300,
    "poll_interval_seconds": 2,
    "max_vision_calls_per_run": 200
  }
}
