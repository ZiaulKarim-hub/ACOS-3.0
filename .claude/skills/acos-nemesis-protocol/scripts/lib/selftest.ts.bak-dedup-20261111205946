      diffOf(Array.from({ length: 40 }, (_, i) => `new ${i + 1}`).join("\n") + "\n"));
    const twoNoLine = fixClaims([mk("A", "src/many.ts"), mk("B", "src/many.ts")], diffOf(forty + "tail\n"));
    const threeNoLine = fixClaims([mk("A", "src/many.ts"), mk("B", "src/many.ts"), mk("C", "src/many.ts")], diffOf(forty + "tail\n"));
    const checks: Record<string, boolean> = {
      an_edit_at_line_5_claims_only_the_finding_at_line_5: atFive.mark.map((i) => i.id).join(",") === "A" && atFive.declined === 2,
      a_whole_file_rewrite_past_the_cap_claims_none: wholeFile.mark.length === 0 && wholeFile.declined === LINE_CLAIM_CAP + 1 && /says nothing about any one of them/.test(wholeFile.basis),
      // weaker evidence, tighter cap: "same file" is allowed only when there is almost nothing
      // on the file to confuse it with
      two_findings_with_no_line_are_still_claimable: twoNoLine.mark.length === 2,
      three_are_not: threeNoLine.mark.length === 0 && /not one has a recorded line inside a changed hunk/.test(threeNoLine.basis),
      // an empty candidate list is not an error and records nothing
      no_open_finding_is_a_quiet_no: fixClaims([], diffOf(forty + "tail\n")).mark.length === 0,
    };
    const bad = Object.entries(checks).filter(([, v]) => !v).map(([k]) => k);
    return bad.length === 0 || `failed: ${bad.join(", ")}\natFive=${JSON.stringify(atFive.mark.map((i) => i.id))} ${atFive.basis}\nwholeFile=${wholeFile.mark.length} ${wholeFile.basis}\ntwoNoLine=${twoNoLine.mark.length}\nthreeNoLine=${threeNoLine.mark.length} ${threeNoLine.basis}`;
  });

  test("R-079 the brake covers the SHELL door too, not only Write/Edit (D-61)", () => {
    // D-56 put the brake in pre-tool.ts, which judges Write/Edit/NotebookEdit. Code written by a
    // shell command is judged by post-tool.ts instead (D-16), and that hook touched the brake
    // nowhere: it neither counted a denial nor cleared one. Measured on website-design-okoa/v2 at
    // 2026-11-10T02:21Z: 9 of the last 10 denials arrived through the shell door, the judge said
    // `stuck` on 9 of 11 verdicts and asked for rungs 2, 3 and 5, and `brake.json` had not been
    // written for 3 hours 22 minutes. 61 of that day's 212 judged edits came through that door.
    // The loop D-56 exists to stop was running through the door D-56 did not watch.
    const c = mkFixture(); activate(c); openTask(c);
    const REL = "src/shell.ts";
    const abs = path.join(c.root, REL);
    const bashIn = (command: string): Record<string, unknown> => ({ tool_name: "Bash", tool_input: { command } });
    const landViaShell = (body: string): Record<string, unknown> => {
      setStub(c, allowV());
      pre(hook(c, "pre-tool", bashIn(`cat > ${REL}`)).json);          // snapshot the tree
      fs.writeFileSync(abs, body);
      setStub(c, denyV({ where: `${REL}:1`, checklist: "Q2", what: "string-built SQL from input", stuck: true, rung: 2 }));
      return hook(c, "post-tool", { ...bashIn(`cat > ${REL}`), tool_response: {} }).json;
    };
    // three stuck denials, all through the shell door
    for (let n = 1; n <= 3; n++) landViaShell(`export const leak${n} = (b: any) => db.query('select ' + b.id);\n`);
    const brake = readJson<Record<string, { denials: number; rung: number }>>(path.join(P.state(c.root), "brake.json"), {});
    // (1) a shell command NAMING the braked file is refused, and refused WITHOUT a judge call
    const verdictsBefore = readRecords(c.root, "verdicts").length;
    const refused = pre(hook(c, "pre-tool", bashIn(`cat >> ${REL}`)).json);
    const sedRefused = pre(hook(c, "pre-tool", bashIn(`sed -i '' 's/a/b/' ${REL}`)).json);
    const verdictsAfter = readRecords(c.root, "verdicts").length;
    // (2) a shell command that does NOT name it still runs — a brake on one file is not a freeze
    const elsewhere = pre(hook(c, "pre-tool", bashIn("echo probe > src/other.ts")).json);
    // (3) and the WRITE door is still refused, as D-56 always did
    const writeRefused = pre(hook(c, "pre-tool", { tool_name: "Write", tool_input: { file_path: abs, content: "export const x = 1;\n" } }).json);
    /**
     * (4) A judged-clean landing through the shell door clears the counter.
     *
     * On a SECOND file, deliberately stopping at TWO denials — below BRAKE_AT, so the file is
     * still free and the clean landing is something the writer could really reach. Clearing the
     * braked file instead would have meant driving an edit the hook is supposed to refuse, which
     * proves nothing about a path a writer can actually walk.
     */
    const TWO = "src/two.ts";
    const landTwo = (body: string, deny: boolean): void => {
      setStub(c, allowV());
      pre(hook(c, "pre-tool", bashIn(`cat > ${TWO}`)).json);
      fs.writeFileSync(path.join(c.root, TWO), body);
      setStub(c, deny ? denyV({ where: `${TWO}:1`, checklist: "Q2", what: "string-built SQL from input", stuck: true, rung: 2 }) : allowV());
      hook(c, "post-tool", { ...bashIn(`cat > ${TWO}`), tool_response: {} });
    };
    landTwo("export const a = (b: any) => db.query('select ' + b.id);\n", true);
    landTwo("export const b = (b: any) => db.query('select ' + b.id);\n", true);
    const twoBraking = readJson<Record<string, { denials: number }>>(path.join(P.state(c.root), "brake.json"), {});
    landTwo("export const safe = 1;\n", false);
    const cleared = readJson<Record<string, { denials: number; acks: number }>>(path.join(P.state(c.root), "brake.json"), {});
    const postSrc = fs.readFileSync(path.join(HOOKS, "post-tool.ts"), "utf8");
    const checks: Record<string, boolean> = {
      // the shell door now RAISES the brake at all, which it never did
      three_shell_denials_braked_the_file: (brake[REL]?.denials ?? 0) >= 3 && (brake[REL]?.rung ?? 0) >= 2,
      a_shell_command_naming_it_is_refused: refused.permissionDecision === "deny" && /NEMESIS STOPPED this edit WITHOUT judging it/.test(refused.permissionDecisionReason ?? ""),
      the_refusal_says_which_door_it_came_through: /arrived as a SHELL command naming src\/shell\.ts/.test(refused.permissionDecisionReason ?? ""),
      sed_is_refused_the_same_way: sedRefused.permissionDecision === "deny",
      // "without judging it" has to be true, not just claimed: no judge call was spent
      no_judge_call_was_spent_on_either: verdictsAfter === verdictsBefore,
      a_command_elsewhere_still_runs: elsewhere.permissionDecision === "allow",
      the_write_door_is_still_refused: writeRefused.permissionDecision === "deny",
      two_shell_denials_count_but_do_not_brake: (twoBraking[TWO]?.denials ?? 0) === 2 && !fs.readFileSync(path.join(HOOKS, "..", "lib", "ladder.ts"), "utf8").includes("BRAKE_AT = 2"),
      a_clean_shell_landing_clears_it: !(TWO in cleared),
      and_the_braked_file_is_still_braked: (cleared[REL]?.denials ?? 0) >= 3,
      // and the counting lives in the hook, not only in this test
      post_tool_counts_and_clears: /noteDenial\(root, rel, reply\.verdict\.history_assessment, issues\)/.test(postSrc) && /clearBrakeOnClean\(root, rel\)/.test(postSrc),
    };
    const bad = Object.entries(checks).filter(([, v]) => !v).map(([k]) => k);
    return bad.length === 0 || `failed: ${bad.join(", ")}\nbrake=${JSON.stringify(brake)}\nrefused=${JSON.stringify(refused).slice(0, 300)}\ntwoBraking=${JSON.stringify(twoBraking)}\ncleared=${JSON.stringify(cleared)}\nverdicts ${verdictsBefore}->${verdictsAfter}`;
  });

  // ── reachability and test-mode guard (non-test-mode fixture) ────────────
  const c6 = mkFixture({ testMode: false });
  activate(c6); openTask(c6);
  test("unreachable judge denies naming what broke", () => {
    const r = pre(hook(c6, "pre-tool", editInput(c6), { NEMESIS_JUDGE_STUB: "" }).json);
    return (r.permissionDecision === "deny" && /claude binary not found/.test(r.permissionDecisionReason ?? "") && /Cause class: crash/.test(r.permissionDecisionReason ?? "")) || JSON.stringify(r);
  });
  test("stub judge ignored without test_mode", () => {
    setStub(c6, allowV());
    const r = pre(hook(c6, "pre-tool", editInput(c6)).json);
    const rec = readRecords<{ summary?: string }>(c6.root, "verdicts").some((v) => /stub ignored/.test(v.summary ?? ""));
    return (r.permissionDecision === "deny" && /claude binary not found/.test(r.permissionDecisionReason ?? "") && rec) || `${JSON.stringify(r)} rec=${rec}`;
  });
  test("judge token exempts the child and a wrong token does not", () => {
    fs.writeFileSync(path.join(c6.home, "token"), "secret-token-123\n", { mode: 0o600 });
    const good = pre(hook(c6, "pre-tool", editInput(c6), { ACOS_NEMESIS_JUDGE: "secret-token-123" }).json);
    const bad = pre(hook(c6, "pre-tool", editInput(c6), { ACOS_NEMESIS_JUDGE: "wrong" }).json);
    return (good.permissionDecision === "allow" && good.permissionDecisionReason === "nemesis_judge_session" && bad.permissionDecision === "deny") || JSON.stringify({ good, bad });
  });

  const ms = Date.now() - t0;
  if (failures) { console.log(`selftest: ${failures} FAILED, ${passes} ok (${ms}ms)`); return 1; }
  console.log(`selftest: all guarantees hold (${passes} ok, ${ms}ms)`);
  return 0;
}

if (import.meta.main) process.exit(await runSelftest(process.argv.includes("--verbose")));
