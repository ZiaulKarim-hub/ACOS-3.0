    // THE LEAK. `serve` opened with `fs.unlinkSync(SOCK)` and then bound its own socket at the same
    // path. That does not stop the daemon already there — a unix socket path has exactly ONE bound
    // inode, so the previous daemon simply loses its name and keeps running, accepting nothing,
    // forever. And `startDaemon` spawned unconditionally whenever no socket file was visible, so two
    // hooks stopping in the same second started two daemons and the second orphaned the first.
    // Measured on this machine 2026-11-10T07:07Z: 104 daemons started over seven days, 44 still
    // alive, exactly 1 reachable (a connect answered in 4ms), 287,424 KB held — and `stop`, which
    // read only PID_FILE, would have killed 1 of the 44 and printed success.
    // Declared before the try, because the `finally` needs it to confirm its own kills.
    // `process.kill(pid, 0)` SUCCEEDS on a zombie — a child that exited and was never waited on —
    // so it cannot see an exit at all. And `child.exitCode` is only filled when node delivers the
    // exit event, which it cannot do while this test busy-waits in `Bun.sleepSync`: the poll blocks
    // the very loop that would answer it. `ps -o stat=` needs neither.
    const running = (pid: number | undefined): boolean => {
      if (!pid) return false;
      const r = spawnSync("/bin/ps", ["-o", "stat=", "-p", String(pid)], { encoding: "utf8" });
      const st = (r.stdout ?? "").trim();
      return st.length > 0 && !st.startsWith("Z");          // Z = exited, not yet reaped
    };
    const extraPids: number[] = [];                 // anything the lock cases started, reaped below
    const home = fs.mkdtempSync("/tmp/nemd63-");
    const sock = path.join(home, "nemesis.sock");
    const env: Record<string, string> = { ...process.env as Record<string, string>, NEMESIS_HOME_OVERRIDE: home };
    const out = fs.openSync(path.join(home, "daemon.out"), "a");
    const DAEMON = path.join(SKILL_DIR, "scripts", "nemesis-daemon.ts");
    const first = spawn(BUN, [DAEMON, "serve"], { env, stdio: ["ignore", out, out] });
    let second: ReturnType<typeof spawn> | null = null;
    try {
      const t0 = Date.now(); while (!fs.existsSync(sock) && Date.now() - t0 < 20000) Bun.sleepSync(100);
      const boundFirst = fs.existsSync(sock);
      const inoFirst = boundFirst ? fs.statSync(sock).ino : 0;

      // a SECOND daemon on the same home must not take the path away from the first
      second = spawn(BUN, [DAEMON, "serve"], { env, stdio: ["ignore", out, out] });
      const t1 = Date.now(); while (running(second.pid ?? 0) && Date.now() - t1 < 20000) Bun.sleepSync(100);
      const secondExited = !running(second.pid ?? 0);
      const inoAfter = fs.existsSync(sock) ? fs.statSync(sock).ino : 0;
      const firstStillAlive = running(first.pid ?? 0);
      const log = fs.existsSync(path.join(home, "daemon.out")) ? fs.readFileSync(path.join(home, "daemon.out"), "utf8") : "";

      // ── the spawn lock ────────────────────────────────────────────────────────────────────
      // THIS MUST RUN IN A CHILD PROCESS. `judge.ts` resolves NEMESIS_HOME (and therefore
      // START_LOCK) once, at import time, from the environment. Setting the override here and
      // calling `startDaemon()` in-process therefore aimed at the REAL `~/.acos/nemesis`: the
      // first version of this test wrote a lock there and spawned a live daemon carrying a /tmp
      // home in its environment, which then bound a socket nobody would ever use and which the
      // test did not know the pid of. It also made the assertion pass for the wrong reason — it
      // checked that nothing landed in the temp dir, which was true because everything landed in
      // the real one. A test that touches live state is not a test of anything.
      //
      // So: a SECOND temp home with no daemon in it, and the question becomes observable —
      // does a socket appear there or not?
      const home2 = fs.mkdtempSync("/tmp/nemd63b-");
      const lock2 = path.join(home2, "daemon.start.lock");
      const sock2 = path.join(home2, "nemesis.sock");
      const callStart = (): string => {
        const r = spawnSync(BUN, ["-e", `const j = await import(${JSON.stringify(path.join(SKILL_DIR, "scripts", "lib", "judge.ts"))}); console.log(j.START_LOCK); console.log(String(j.startDaemon()));`],
          { encoding: "utf8", env: { ...process.env as Record<string, string>, NEMESIS_HOME_OVERRIDE: home2 } });
        return (r.stdout ?? "").trim();
      };
      const waitForSock = (ms: number): boolean => { const t = Date.now(); while (!fs.existsSync(sock2) && Date.now() - t < ms) Bun.sleepSync(100); return fs.existsSync(sock2); };

      // (a) a FRESH lock: nothing may be started
      fs.writeFileSync(lock2, "999999\n");
      const outLocked = callStart();
      // the override really reached the child — without this the case below proves nothing
      const childUsedTheTempHome = outLocked.split("\n")[0] === lock2;
      const spawnedWhileLocked = waitForSock(4000);
      const startedWhileLocked = outLocked.split("\n")[1] === "true";

      // (b) a STALE lock must not block a start forever
      const staleAge = new Date(Date.now() - START_LOCK_STALE_MS - 5000);
      fs.utimesSync(lock2, staleAge, staleAge);
      const staleIsOld = Date.now() - fs.statSync(lock2).mtimeMs > START_LOCK_STALE_MS;
      callStart();
      const spawnedAfterStale = waitForSock(20000);
      // whatever that start produced is ours to clean up
      const home2Pids = (() => {
        const r = spawnSync("/bin/ps", ["-eo", "pid=,command="], { encoding: "utf8" });
        return (r.stdout ?? "").split("\n").filter((l) => l.includes("nemesis-daemon.ts") && l.includes("serve") && !l.includes("grep"))
          .map((l) => Number(l.trim().split(/\s+/)[0])).filter((n) => Number.isFinite(n) && n > 0 && n !== first.pid && n !== second?.pid);
      })();
      for (const pid of home2Pids) {
        const r = spawnSync("/bin/ps", ["-E", "-p", String(pid)], { encoding: "utf8" });
        if ((r.stdout ?? "").includes(`NEMESIS_HOME_OVERRIDE=${home2}`)) extraPids.push(pid);
      }
      fs.rmSync(home2, { recursive: true, force: true });

      const src = fs.readFileSync(DAEMON, "utf8");
      const jsrc = fs.readFileSync(path.join(SKILL_DIR, "scripts", "lib", "judge.ts"), "utf8");
      const checks: Record<string, boolean> = {
        // the first daemon really did bind, or nothing below means anything
        the_first_daemon_bound: boundFirst && inoFirst > 0,
        // (1) the second one left rather than stealing the path
        the_second_daemon_exited: secondExited,
        the_socket_is_the_same_one: inoAfter === inoFirst,
        the_first_daemon_is_untouched: firstStillAlive,
        it_says_why_it_left: /already serving/.test(log) && /R-081/.test(log),
        // (2) a live socket is never unlinked — the unlink is reached only past the probe
        the_unlink_is_guarded: /if \(await someoneIsServing\(\)\) \{/.test(src) && src.indexOf("someoneIsServing()) {") < src.indexOf("fs.unlinkSync(SOCK); } catch { /* none */ }     // only a STALE socket"),
        // (3) one spawner at a time, and the lock is named rather than implied
        the_start_takes_an_exclusive_lock: /fs\.openSync\(START_LOCK, "wx"\)/.test(jsrc),
        // the override reached the child, so the two cases below are about the temp home and not
        // about the real one — the mistake the first version of this test made
        the_lock_case_is_isolated: childUsedTheTempHome,
        // a held lock: the caller is told a daemon is coming, and does NOT add one
        a_fresh_lock_stops_a_second_start: startedWhileLocked === true && spawnedWhileLocked === false,
        // and an abandoned lock does not block a start forever
        a_stale_lock_is_cleared: staleIsOld && spawnedAfterStale === true && /Date\.now\(\) - st\.mtimeMs < START_LOCK_STALE_MS/.test(jsrc),
        // (4) stop reaps the fleet, not one process of it
        stop_enumerates_every_daemon: /const pids = new Set<number>\(daemonPids\(\)\)/.test(src) && /nemesis-daemon\.ts/.test(src),
        stop_no_longer_trusts_the_pid_file_alone: !/process\.kill\(pid, "SIGTERM"\); console\.log\(`stopped pid/.test(src),
        // (5) and launchd must not respawn a clean "someone else is serving" exit
        keepalive_is_crash_only: /<key>KeepAlive<\/key><dict><key>SuccessfulExit<\/key><false\/><\/dict>/.test(src),
      };
      const bad = Object.entries(checks).filter(([, v]) => !v).map(([k]) => k);
      return bad.length === 0 || `failed: ${bad.join(", ")}\ninoFirst=${inoFirst} inoAfter=${inoAfter} secondExited=${secondExited} firstAlive=${firstStillAlive}\nlog=${log.slice(-400)}`;
    } finally {
      // A SIGTERM that arrives while the daemon is still coming up can be missed, and this test
      // was observed leaving one 41,152 KB daemon behind on a temp home. So the kill is CONFIRMED
      // against the process table and escalated — a cleanup that can silently fail is the very
      // defect D-63 is about, and leaving one in the test for it would be its own joke.
      const hardKill = (pid: number | undefined): void => {
        if (!pid) return;
        for (const sig of ["SIGTERM", "SIGKILL"] as const) {
          try { process.kill(pid, sig); } catch { return; }      // already gone
          const t = Date.now();
          while (running(pid) && Date.now() - t < 3000) Bun.sleepSync(50);
          if (!running(pid)) return;
        }
      };
      hardKill(first.pid);
      hardKill(second?.pid);
      for (const pid of extraPids) hardKill(pid);
      try { fs.closeSync(out); } catch { /* closed */ }
    }
  });

