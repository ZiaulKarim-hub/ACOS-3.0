/**
 * report.ts — the plain-language ledger report for Zee (R-042, R-024, D-28, D-08).
 * No code, no diffs. Markdown plus a local standalone HTML page (Google Fonts only).
 * Never a claude.ai artifact.
 */
import * as fs from "node:fs";
import * as path from "node:path";
import { P, listIssues, listTasks, type Issue, nowIso } from "./state";
import { listScans } from "./scan";
import { rung } from "./ladder";

function plain(s: string | undefined): string { return (s ?? "").replace(/`/g, "'").replace(/```[\s\S]*?```/g, "[code omitted]"); }

function issueParagraph(i: Issue): string {
  const lines: string[] = [];
  lines.push(`### ${i.id} — ${i.severity} ${i.lens === "PSC" ? "security" : "functionality"} issue (${i.status})`);
  lines.push(`What was found: ${plain(i.what)} (rule ${i.checklist}, at ${plain(i.where)}).`);
  if (i.root_cause) lines.push(`The real cause: ${plain(i.root_cause)}.`);
  const tries = i.attempts.length;
  lines.push(`Attempts so far: ${tries}. Current rung: ${i.rung} (${rung(i.rung).name}).`);
  if (i.repro) lines.push(`How we know when it is fixed: a test named "${i.repro.name}" reproduces the bug and must pass.`);
  if (i.review) lines.push(`Independent review: ${i.review.confirmed_fixed ? "confirmed the fix" : "did NOT confirm the fix"} (${i.review.by}).`);
  if (i.second_opinion) lines.push(`Second opinion from another model: ${i.second_opinion.status === "received" ? `received from ${i.second_opinion.provider}` : "not available (no provider configured)"}.`);
  if (i.revert) lines.push(`Reverted on ${i.revert.at.slice(0, 10)} to the last good state, files: ${i.revert.files.join(", ")}. The issue stayed open.`);
  if (i.decision) lines.push(`Product decision recorded: ${i.decision.choice} by ${i.decision.owner}${i.decision.note ? ` — ${plain(i.decision.note)}` : ""}.`);
  if (i.status === "closed") lines.push(`Closed on ${i.closed_at?.slice(0, 10)} after the reproduction test passed, the whole suite passed, two clean scans, and an independent review.`);
  return lines.join("\n");
}

export function buildReport(root: string, taskId?: string): string {
  const issues = listIssues(root).filter((i) => !taskId || i.task === taskId);
  const tasks = listTasks(root).filter((t) => !taskId || t.id === taskId);
  const scans = listScans(root, taskId);
  const last = scans[scans.length - 1];
  const open = issues.filter((i) => i.status !== "closed" && i.status !== "decided");
  const out: string[] = [];
  out.push(`# Nemesis report — ${nowIso().slice(0, 16).replace("T", " ")}`);
  out.push("");
  out.push(`## In one paragraph`);
  out.push(`${tasks.length} task(s): ${tasks.filter((t) => t.status === "closed").length} closed, ${tasks.filter((t) => t.status === "open").length} open. ${issues.length} issue(s) found in total: ${issues.filter((i) => i.status === "closed").length} fixed and proven, ${issues.filter((i) => i.status === "decided").length} settled by a product decision, ${open.length} still open. Last scan: ${last ? (last.clean ? "clean" : "not clean") + " at " + last.at.slice(0, 16).replace("T", " ") : "none yet"}.`);
  out.push("");
  if (open.length) {
    out.push(`## Still open (${open.length})`);
    for (const i of open) out.push(issueParagraph(i), "");
  }
  const fixed = issues.filter((i) => i.status === "closed");
  if (fixed.length) {
    out.push(`## Fixed and proven (${fixed.length})`);
    for (const i of fixed) out.push(issueParagraph(i), "");
  }
  const decided = issues.filter((i) => i.status === "decided");
  if (decided.length) {
    out.push(`## Settled by a product decision (${decided.length})`);
    for (const i of decided) out.push(issueParagraph(i), "");
  }
  out.push(`## Tasks`);
  for (const t of tasks) out.push(`- ${t.id} — ${t.title}: ${t.status}${t.closed_at ? ` (closed ${t.closed_at.slice(0, 10)})` : ""}`);
  if (!tasks.length) out.push("- (none)");
  return out.join("\n") + "\n";
}

/** Rung 8: the product report. Three choices only. No code. */
export function buildProductReport(root: string): string {
  const open = listIssues(root, true);
  const out: string[] = [];
  out.push(`# Decisions needed — ${nowIso().slice(0, 10)}`);
  out.push("");
  out.push(`Every automatic fix rung was tried on the issues below. None of them needs you to fix code. Each needs ONE product decision: drop the feature, change the requirement, or accept the risk with a named owner and date. Record a decision with: \`nemesis issue decide <id> --choice <drop|change|accept> --owner <who>\`.`);
  out.push("");
  if (!open.length) out.push("Nothing is open. No decision is needed.");
  for (const i of open) {
    out.push(`## ${i.id} — ${plain(i.what)}`);
    out.push(`Severity: ${i.severity}. Kind: ${i.lens === "PSC" ? "security rule " + i.checklist : "functionality (" + i.checklist + ")"}. Task: ${i.task}.`);
    if (i.root_cause) out.push(`Why it keeps happening: ${plain(i.root_cause)}.`);
    out.push(`What was tried: ` + i.history.filter((h) => h.event === "rung" || h.event === "re-found" || h.event === "reverted" || h.event === "second-opinion").map((h) => `${h.at.slice(0, 16).replace("T", " ")} ${h.event}${h.detail ? ": " + plain(h.detail) : ""}`).join("; ") + ".");
    out.push(`Your three choices:`);
    out.push(`1. Drop the feature this issue belongs to.`);
    out.push(`2. Change the requirement so the rule and the feature can both hold (say how in one sentence).`);
    out.push(`3. Accept the risk, with an owner and a date to revisit.`);
    out.push("");
  }
  return out.join("\n") + "\n";
}

/** Minimal markdown → HTML (headings, paragraphs, lists, inline code). Local page, Google Fonts only. */
export function renderHtml(md: string, title: string): string {
  const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  const body = md.split("\n").map((l) => {
    if (/^### /.test(l)) return `<h3>${esc(l.slice(4))}</h3>`;
    if (/^## /.test(l)) return `<h2>${esc(l.slice(3))}</h2>`;
    if (/^# /.test(l)) return `<h1>${esc(l.slice(2))}</h1>`;
    if (/^- /.test(l)) return `<li>${esc(l.slice(2))}</li>`;
    if (/^\d+\. /.test(l)) return `<li class="n">${esc(l.replace(/^\d+\. /, ""))}</li>`;
    if (!l.trim()) return "";
    return `<p>${esc(l).replace(/`([^`]+)`/g, "<code>$1</code>")}</p>`;
  }).join("\n").replace(/(<li>[\s\S]*?<\/li>\n?)+/g, (m) => `<ul>${m}</ul>`).replace(/(<li class="n">[\s\S]*?<\/li>\n?)+/g, (m) => `<ol>${m}</ol>`);
  return `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${esc(title)}</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,600&family=Atkinson+Hyperlegible:wght@400;700&display=swap" rel="stylesheet">
<style>:root{--bg:#f6f7f4;--ink:#1d2321;--muted:#5d6a64;--line:#d5dbd6;--accent:#2f6b55}@media(prefers-color-scheme:dark){:root:not([data-theme=light]){--bg:#14181a;--ink:#e8ece9;--muted:#9aa6a0;--line:#2b3335;--accent:#7fc2a3}}:root[data-theme=dark]{--bg:#14181a;--ink:#e8ece9;--muted:#9aa6a0;--line:#2b3335;--accent:#7fc2a3}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Atkinson Hyperlegible",system-ui,sans-serif;line-height:1.55}main{max-width:760px;margin:0 auto;padding:32px 16px}h1,h2,h3{font-family:Newsreader,Georgia,serif;font-weight:600;line-height:1.2}h1{font-size:2rem;margin:.2em 0}h2{font-size:1.4rem;margin:1.6em 0 .4em;border-bottom:1px solid var(--line);padding-bottom:.2em}h3{font-size:1.1rem;margin:1.2em 0 .3em;color:var(--accent)}p{margin:.4em 0}code{font-family:"JetBrains Mono",ui-monospace,monospace;font-size:.9em;background:color-mix(in srgb,var(--line) 50%,transparent);padding:1px 4px;border-radius:3px}ul,ol{padding-left:1.3em}li{margin:.25em 0}</style></head>
<body><main>${body}</main></body></html>`;
}

export function writeReport(root: string, kind: "ledger" | "product", taskId?: string): { md: string; html: string } {
  fs.mkdirSync(P.reports(root), { recursive: true });
  const md = kind === "product" ? buildProductReport(root) : buildReport(root, taskId);
  const stamp = nowIso().slice(0, 19).replace(/[:T]/g, "-");
  const base = path.join(P.reports(root), `${stamp}-${kind}${taskId ? "-" + taskId : ""}`);
  fs.writeFileSync(`${base}.md`, md);
  fs.writeFileSync(`${base}.html`, renderHtml(md, kind === "product" ? "Nemesis decisions" : "Nemesis report"));
  return { md: `${base}.md`, html: `${base}.html` };
}
