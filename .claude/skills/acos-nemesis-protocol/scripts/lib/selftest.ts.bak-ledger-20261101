const HOOKS = path.join(SKILL_DIR, "scripts", "hooks");

interface Ctx { root: string; home: string; stub: string; env: Record<string, string> }
let verbose = false;
let failures = 0;
let passes = 0;

function okLine(name: string, pass: boolean, detail?: string): void {
  if (pass) { passes++; console.log(`ok   ${name}`); }
  else { failures++; console.log(`FAIL ${name}${detail ? `\n      ${detail.split("\n").slice(0, 8).join("\n      ")}` : ""}`); }
}
function test(name: string, fn: () => boolean | string): void {
  try { const r = fn(); if (r === true) okLine(name, true); else okLine(name, false, typeof r === "string" ? r : "assertion false"); }
  catch (e) { okLine(name, false, e instanceof Error ? e.stack ?? e.message : String(e)); }
}

