function allowV(): string { return JSON.stringify({ decision: "allow", findings: [], history_assessment: { stuck: false, recommended_rung: 1, why: "clean" } }); }
function denyV(extra: Partial<{ severity: string; lens: string; checklist: string; where: string; what: string; stuck: boolean; rung: number }> = {}): string {
  return JSON.stringify({ decision: "deny", findings: [{ severity: extra.severity ?? "high", lens: extra.lens ?? "PSC", checklist: extra.checklist ?? "Q3", where: extra.where ?? "src/app.ts:3", what: extra.what ?? "trusts a client-supplied user id", root_cause: "the handler reads userId from the body", fix_hint: "take the id from the session, check the row" }], history_assessment: { stuck: extra.stuck ?? false, recommended_rung: extra.rung ?? 1, why: extra.stuck ? "the same symptom keeps returning; a fresh agent should take over" : "first attempt" } });
}

function mkFixture(opts: { testRunner?: boolean; testMode?: boolean } = {}): Ctx {
  const base = fs.mkdtempSync(path.join(os.tmpdir(), "nemesis-selftest-"));
  const root = path.join(base, "proj"); const home = path.join(base, "home");
  fs.mkdirSync(path.join(root, "src"), { recursive: true }); fs.mkdirSync(home, { recursive: true });
  const scripts: Record<string, string> = opts.testRunner === false ? {} : { typecheck: "true", lint: "true", test: "bun test", audit: "true" };
  fs.writeFileSync(path.join(root, "package.json"), JSON.stringify({ name: "fixture", private: true, scripts }));
  fs.writeFileSync(path.join(root, "bun.lock"), "");
  fs.writeFileSync(path.join(root, "src", "app.ts"), "export function app(userId: string) { return userId; }\n");
  if (opts.testRunner !== false) fs.writeFileSync(path.join(root, "app.test.ts"), 'import { test, expect } from "bun:test";\ntest("app returns id", () => { expect(1).toBe(1); });\n');
  const stub = path.join(base, "stub.json");
  fs.writeFileSync(path.join(base, "holdout-stub.json"), JSON.stringify(HOLDOUT_STUB));
  fs.writeFileSync(path.join(base, "review-stub.json"), JSON.stringify(REVIEW_STUB));
  fs.writeFileSync(path.join(base, "release-stub.json"), JSON.stringify(RELEASE_STUB));
  const env: Record<string, string> = { ...process.env as Record<string, string>, NEMESIS_HOME_OVERRIDE: home, NEMESIS_NO_AUTOSTART: "1", NEMESIS_CLAUDE_BIN: "/nonexistent/claude", NEMESIS_JUDGE_STUB: stub, NEMESIS_HOLDOUT_STUB: path.join(base, "holdout-stub.json"), NEMESIS_REVIEW_STUB: path.join(base, "review-stub.json"), NEMESIS_RELEASE_STUB: path.join(base, "release-stub.json") };
  delete env.CLAUDE_CODE_SESSION_ID;
  const ctx: Ctx = { root, home, stub, env };
  cli(ctx, ["enroll", root]);
  if (opts.testMode !== false) { const cfg = readJson<Record<string, unknown>>(P.config(root), {}); cfg.test_mode = true; writeJson(P.config(root), cfg); }
  return ctx;
}

function cli(ctx: Ctx, args: string[], env: Record<string, string> = {}): { status: number | null; out: string } {
  const r = spawnSync(BUN, [CLI, ...args], { cwd: ctx.root, encoding: "utf8", env: { ...ctx.env, ...env } });
  const out = `${r.stdout}\n${r.stderr}`;
  if (verbose) console.log(`  $ nemesis ${args.join(" ")} → ${r.status}\n${out.trim().split("\n").map((l) => "    " + l).join("\n")}`);
  return { status: r.status, out };
}
function hook(ctx: Ctx, name: "pre-tool" | "post-tool" | "stop" | "prompt", input: Record<string, unknown>, env: Record<string, string> = {}): { status: number | null; json: Record<string, unknown>; raw: string } {
  const r = spawnSync(BUN, [path.join(HOOKS, `${name}.ts`)], { cwd: ctx.root, encoding: "utf8", input: JSON.stringify({ cwd: ctx.root, ...input }), env: { ...ctx.env, ...env } });
  let json: Record<string, unknown> = {};
  try { json = JSON.parse(r.stdout.trim() || "{}") as Record<string, unknown>; } catch { json = { _raw: r.stdout }; }
  if (verbose) console.log(`  hook ${name} ${String(input.tool_name ?? "")} → ${r.status} ${r.stdout.slice(0, 300)}${r.stderr ? "\n    stderr: " + r.stderr.slice(0, 300) : ""}`);
  return { status: r.status, json, raw: r.stdout + r.stderr };
}
const pre = (j: Record<string, unknown>) => (j.hookSpecificOutput as { permissionDecision?: string; permissionDecisionReason?: string } | undefined) ?? {};
function activate(ctx: Ctx, goal = "build the fixture login flow securely"): void { writeActive(ctx.root, { goal, started_at: new Date().toISOString(), started_loop: false }); }
function setStub(ctx: Ctx, text: string): void { fs.writeFileSync(ctx.stub, text); }
function openTask(ctx: Ctx, id = "fx"): void {
  const t = cli(ctx, ["task", "start", id, "--title", "fixture login"]); if (t.status !== 0) throw new Error("task start failed: " + t.out);
  const sk = path.join(ctx.root, "sketch.yaml"); fs.writeFileSync(sk, SKETCH);
  const s = cli(ctx, ["task", "sketch", id, sk]); if (s.status !== 0) throw new Error("task sketch failed: " + s.out);
  const dr = path.join(ctx.root, "design.yaml"); fs.writeFileSync(dr, DESIGN);
  const d = cli(ctx, ["task", "design", id, dr]); if (d.status !== 0) throw new Error("task design failed: " + d.out);
}
function editInput(ctx: Ctx, rel = "src/app.ts", content = "export function app(userId: string) { return db.get(userId); }\n"): Record<string, unknown> {
  return { tool_name: "Write", tool_input: { file_path: path.join(ctx.root, rel), content } };
}
function transcript(ctx: Ctx, lines: Record<string, unknown>[]): string {
  const p = path.join(path.dirname(ctx.root), "transcript.jsonl");
  fs.writeFileSync(p, lines.map((l) => JSON.stringify(l)).join("\n") + "\n");
  return p;
}
function denyIssueOn(ctx: Ctx, where = "src/app.ts:3", extra: Record<string, unknown> = {}): { reason: string; issues: ReturnType<typeof listIssues> } {
  setStub(ctx, denyV({ where, ...(extra as object) }));
  const r = hook(ctx, "pre-tool", editInput(ctx));
  return { reason: pre(r.json).permissionDecisionReason ?? "", issues: listIssues(ctx.root, true) };
}

