#!/usr/bin/env bun
/**
 * nemesis.ts — the acos-nemesis-protocol command line. Thin SKILL.md, thick CLI (D-24).
 * Run `bun nemesis.ts help` for the command list. Every command that changes state writes
 * an artifact and a record; hooks check those files, never the model's word.
 */
import * as fs from "node:fs";
import * as path from "node:path";
import { spawnSync } from "node:child_process";
import {
  SKILL_DIR, BUN, P, nemesisDir, readConfig, readActive, writeActive, writeJson, readJson, appendRecord, nowIso, sha256,
  createTask, readTask, writeTask, listTasks, currentTask, readChecklists, writeChecklists, checklistGaps, CHECKLIST_IDS,
  listIssues, readIssue, writeIssue, isOpen, closureCheck, recordFindings, writeGreenSnapshot, restoreFromSnapshot, installHooks, countInstalledHooks, refreshTreeIndex, diffIndex,
  projectRootFrom, type Config, type Issue, type Finding, type ChecklistEntry,
} from "./lib/state";
import { isInScope } from "./lib/scope";
import { STEP_IDS, markStep, resetStep, stepsStatus, unfinishedSteps, readSteps } from "./lib/steps";
import { detectToolchain, runScan, listScans, scanSummary, scanFindings, isClean } from "./lib/scan";
import { requestGeneric, startDaemon, buildRequest, requestVerdict, SOCK } from "./lib/judge";
import { buildReviewCharter, buildReleaseCharter, buildHoldoutAuthorCharter } from "./lib/charter";
import { parseVerdict, classifyFailure, recoveryPlan, repairJson, finalDenial } from "./lib/verdict";
import { rungInstruction, setPositionRung, retryFromRung3, RUNGS } from "./lib/ladder";
import { writeReport } from "./lib/report";
import { rulebookIsFresh } from "./build-rulebook";

const HOLDOUT = path.join(process.env.HOME ?? "", ".claude", "skills", "acos-holdout-test", "scripts", "holdout.ts");
const ACOS_SCRIPTS = (root: string) => path.join(root, ".claude", "scripts");

function die(msg: string, code = 1): never { console.error(`nemesis: ${msg}`); process.exit(code); }
function ok(msg: string): void { console.log(msg); }
function rootOrDie(explicit?: string): string {
  const r = projectRootFrom(explicit ?? process.cwd());
  if (!r) die(`not an enrolled project (no .nemesis/config.json above ${explicit ?? process.cwd()}). Run: nemesis enroll <dir>`);
  return r;
}
function flag(args: string[], name: string): string | undefined { const i = args.indexOf(name); return i >= 0 ? args[i + 1] : undefined; }
function positional(args: string[]): string[] { const out: string[] = []; for (let i = 0; i < args.length; i++) { if (args[i]!.startsWith("--")) { i++; continue; } out.push(args[i]!); } return out; }

// ── enroll / scope ──────────────────────────────────────────────────────────

export function cmdEnroll(dirArg?: string, opts: { prd?: string } = {}): void {
  const root = path.resolve(dirArg ?? process.cwd());
  if (!fs.existsSync(root)) die(`no such directory: ${root}`);
  const existing = readJson<Config | null>(P.config(root), null);
  const cfg: Config = existing ?? { schema: "nemesis-config/1", enrolled_at: nowIso(), skill_dir: SKILL_DIR };
  cfg.skill_dir = SKILL_DIR;
  if (opts.prd) cfg.prd = opts.prd;
  // R-002: the scope rules are visible and editable in config.json (defaults from templates/config.json)
  if (!Array.isArray(cfg.source_globs) || !cfg.source_globs.length) cfg.source_globs = ["**"];
  if (!Array.isArray(cfg.exclude_globs)) cfg.exclude_globs = [];
  // `enroll` NEVER writes test_mode (R-051).
  delete (cfg as { test_mode?: boolean }).test_mode;
  cfg.toolchain = { detected: detectToolchain(root, cfg).map((c) => `${c.id}:${c.cmd ? [c.cmd, ...(c.args ?? [])].join(" ") : c.builtin ? "built-in" : "skipped (" + c.note + ")"}`) };
  for (const d of ["state", "tasks", "issues", "records/scans", "snapshots", "holdout", "reports"]) fs.mkdirSync(path.join(nemesisDir(root), d), { recursive: true });
  writeJson(P.config(root), cfg);
  const gi = path.join(nemesisDir(root), ".gitignore");
  fs.writeFileSync(gi, ["state/", "snapshots/", "holdout/*/pack/", "holdout/*/pack", "reports/", "records/scans/", "*.tmp", ""].join("\n"));
  const { settings, installed } = installHooks(root, SKILL_DIR);
  appendRecord(root, "enroll", { event: "enrolled", skill_dir: SKILL_DIR, hooks: installed });
  ok(`enrolled: ${root}\n  config: ${P.config(root)}\n  hooks (${installed.join(", ")}) installed once each in ${settings}\n  toolchain: ${(cfg.toolchain.detected as string[]).join(" | ")}\nNext: nemesis on "<goal>" [--prd <file>]`);
}

export function cmdScope(target: string, dirArg?: string): void {
  const root = rootOrDie(dirArg);
  const cfg = readConfig(root);
  const r = isInScope(root, target, cfg);
  ok(r.inScope ? `in-scope: ${r.rel}` : `excluded (${r.rule}): ${r.rel}`);
}

// ── on / off / status ───────────────────────────────────────────────────────

/** Mirrors oracle-ctl.ts: under four words, or placeholder shapes, is not a goal. */
export function looksVague(goal: string): boolean {
  const g = goal.trim().toLowerCase();
  if (g.split(/\s+/).filter(Boolean).length < 4) return true;
  return /^(finish|complete|do|continue|resume|keep going|keep working|carry on)\b.*\b(the )?(work|task|job|project|it|this|whatever)\b/.test(g) || /^continue whatever/.test(g);
}

export function cmdOn(goal: string, opts: { prd?: string; dir?: string }): void {
  const root = rootOrDie(opts.dir);
  const cfg = readConfig(root);
  if (!goal || looksVague(goal)) die(`NEEDS_GOAL: "${goal}" is too vague. Name the subject and the outcome in at least four words (the judge weighs every chunk against it).`, 3);
  if (opts.prd && !fs.existsSync(path.resolve(root, opts.prd))) die(`PRD not found: ${opts.prd}`);
  const rb = rulebookIsFresh(); if (!rb.fresh) die(`rulebook is stale (${rb.why}); run: bun ${path.join(SKILL_DIR, "scripts", "build-rulebook.ts")}`);
  if (!fs.existsSync(SOCK) && !cfg.test_mode) startDaemon();
  // Keep-going loop (D-20): start autopilot only if no sentinel exists for this session.
  let startedLoop = false;
  const sid = process.env.CLAUDE_CODE_SESSION_ID?.trim();
  const activate = path.join(ACOS_SCRIPTS(root), "autopilot-activate.py");
  if (fs.existsSync(activate) && sid) {
    const sentinel = path.join(root, ".acos", "state", `autopilot-active-${sid}`);
    if (!fs.existsSync(sentinel)) {
      const r = spawnSync("python3", [activate, "on", "--session", sid, goal], { cwd: root, encoding: "utf8" });
      startedLoop = r.status === 0;
      ok(`keep-going loop: ${startedLoop ? "started by Nemesis" : "not started (" + (r.stderr || r.stdout).trim().split("\n").pop() + ")"}`);
    } else ok("keep-going loop: already running (Oracle or autopilot started it) — left as is");
  } else ok(`keep-going loop: ${sid ? "autopilot-activate.py not found in this project; Nemesis judges but cannot keep the session going by itself" : "no CLAUDE_CODE_SESSION_ID in the environment; run this from inside the Claude session to start the loop"}`);
  writeActive(root, { goal, prd: opts.prd ?? cfg.prd, started_at: nowIso(), session: sid, started_loop: startedLoop });
  appendRecord(root, "activation", { event: "on", goal, prd: opts.prd ?? cfg.prd, session: sid, started_loop: startedLoop });
  ok(`NEMESIS ON — goal: ${goal}\n  prd: ${opts.prd ?? cfg.prd ?? "(none — drift is judged against the goal and the design review)"}\n  every in-scope edit is now judged; every change is scanned; nothing completes while the ledger is open.`);
}

export function cmdOff(opts: { dir?: string }): void {
  const root = rootOrDie(opts.dir);
  const a = readActive(root);
  if (!a) { ok("NEMESIS already off"); return; }
  if (a.started_loop && a.session) {
    const activate = path.join(ACOS_SCRIPTS(root), "autopilot-activate.py");
    if (fs.existsSync(activate)) spawnSync("python3", [activate, "off", "--session", a.session], { cwd: root, encoding: "utf8" });
  }
  writeActive(root, null);
  appendRecord(root, "activation", { event: "off", open_issues: listIssues(root, true).length });
  ok(`NEMESIS OFF${a.started_loop ? " (loop stopped too)" : ""}. Open issues remain on record: ${listIssues(root, true).length}.`);
}

export function cmdStatus(opts: { dir?: string; json?: boolean }): void {
  const root = rootOrDie(opts.dir);
  const a = readActive(root);
  const open = listIssues(root, true);
  const tasks = listTasks(root);
  const scans = listScans(root);
  const last = scans[scans.length - 1];
  const rb = rulebookIsFresh();
  if (opts.json) { console.log(JSON.stringify({ active: a, open_issues: open.map((i) => ({ id: i.id, severity: i.severity, lens: i.lens, rung: i.rung, status: i.status })), tasks: tasks.map((t) => ({ id: t.id, status: t.status, steps: stepsStatus(root, t.id).steps })), last_scan: last ? scanSummary(last) : null, hooks: countInstalledHooks(root), rulebook: rb }, null, 2)); return; }
  ok(`NEMESIS ${a ? "ON" : "OFF"}${a ? ` — goal: ${a.goal}` : ""}\nproject: ${root}\nrulebook: ${rb.fresh ? "fresh" : "STALE — " + rb.why}\nhooks installed: ${Object.entries(countInstalledHooks(root)).map(([k, v]) => `${k}=${v}`).join(" ") || "none"}\nopen issues: ${open.length}${open.length ? "\n" + open.map((i) => `  ${i.id} [${i.severity}/${i.lens}/${i.checklist}] ${i.status} rung ${i.rung} — ${i.what}`).join("\n") : ""}\nlast S3: ${last ? scanSummary(last) + " at " + last.at : "none"}`);
  for (const t of tasks) {
    const st = stepsStatus(root, t.id);
    ok(`task ${t.id} (${t.status}) — ${t.title}${st.sealOk ? "" : "  [steps.json TAMPERED: seal mismatch]"}`);
    ok("  " + st.steps.map((s) => `${s.id}:${s.tampered ? "TAMPERED" : s.done ? (s.count !== undefined ? `done×${s.count}` : "done") : "—"}`).join(" "));
  }
  if (!tasks.length) ok("tasks: none (nemesis task start <id> --title \"…\")");
}

// ── tasks: start / sketch / design / checklist / end / redesign ─────────────

function requireKeys(text: string, keys: string[]): string[] { return keys.filter((k) => !new RegExp(`^\\s*${k.replace(".", "\\.")}\\s*:`, "m").test(text)); }

export function validateSketch(text: string): string[] {
  const problems = requireKeys(text, ["task", "data_touched", "actors", "stride", "abuse_case", "checklists"]).map((k) => `missing field: ${k}`);
  for (const s of ["spoofing", "tampering", "repudiation", "information_disclosure", "denial_of_service", "elevation_of_privilege"]) {
    const m = text.match(new RegExp(`^[ \\t]+${s}[ \\t]*:[ \\t]*(.*)$`, "m"));
    if (!m || !m[1]!.trim() || /^<.*>$/.test(m[1]!.trim())) problems.push(`stride.${s} is empty or still a placeholder`);
  }
  const dt = text.match(/data_touched\s*:\s*\[([^\]]*)\]/)?.[1] ?? text.match(/data_touched\s*:\s*\n((?:\s+-.*\n?)+)/)?.[1] ?? "";
  if (!dt.trim()) problems.push("data_touched is empty");
  else if (!/(public|internal|confidential|sensitive)/.test(dt)) problems.push("data_touched entries must carry a class: public|internal|confidential|sensitive");
  const ab = text.match(/abuse_case\s*:\s*(.*)$/m)?.[1] ?? "";
  if ((ab.match(/[.!?](\s|$)/g) ?? []).length < 2) problems.push("abuse_case must be at least two sentences from the attacker's view");
  const cl = (text.match(/checklists\s*:\s*\[([^\]]*)\]/)?.[1] ?? "").split(",").map((s) => s.trim().replace(/['"]/g, "")).filter(Boolean);
  if (!cl.length) problems.push("checklists is empty");
  for (const c of cl) if (!(CHECKLIST_IDS as readonly string[]).includes(c)) problems.push(`checklist id "${c}" is not one of ${CHECKLIST_IDS.join(", ")}`);
  if (/<[^>]*>/.test(text.replace(/->/g, ""))) problems.push("template placeholders (<…>) still present");
  return problems;
}

export function validateDesign(text: string): string[] {
  const problems = requireKeys(text, ["data_flow", "authorization_matrix", "rls_rules", "typed_errors", "logging", "ai_use", "reviewer"]).map((k) => `missing field: ${k}`);
  if (!/PERMISSION_DENIED/.test(text) || !/NOT_FOUND/.test(text)) problems.push("typed_errors must include at least PERMISSION_DENIED and NOT_FOUND");
  if (!/never_log\s*:\s*\[[^\]]+\]/.test(text) && !/never_log\s*:\s*\n\s+-/.test(text)) problems.push("logging.never_log must be non-empty");
  if (!/authorization_matrix\s*:\s*\n\s+-\s*action/.test(text)) problems.push("authorization_matrix must list at least one action row (- action: …)");
  if (/<[^>]*>/.test(text.replace(/->/g, ""))) problems.push("template placeholders (<…>) still present");
  return problems;
}

export function cmdTaskStart(id: string, opts: { title?: string; prdRefs?: string[]; dir?: string }): void {
  const root = rootOrDie(opts.dir);
  const cfg = readConfig(root);
  if (!opts.title) die("--title is required");
  const t = createTask(root, id, opts.title, opts.prdRefs ?? []);
  readSteps(root, id); // creates the ledger
  writeChecklists(root, id, {});
  appendRecord(root, "tasks", { event: "start", id, title: opts.title });
  ok(`task ${id} opened — ${opts.title}\n  next: write .nemesis/tasks/${id}/threat-sketch.yaml (template: ${path.join(SKILL_DIR, "templates", "threat-sketch.yaml")}) then: nemesis task sketch ${id} <file>`);
  ok(`  S7 holdout: authored by the daemon from the PRD and S1 when you record the design review (nemesis task design ${id} <file>)`);
}

/** R-033: the daemon (never the writer) authors and seals the task's acceptance holdout. */
export function authorTaskHoldout(root: string, cfg: Config, taskId: string): string {
  const task = readTask(root, taskId)!;
  const a = readActive(root);
  const { contractFor } = require("./lib/judge") as typeof import("./lib/judge");
  const c = contractFor(root, taskId, cfg);
  const hint = (cfg.toolchain?.detected as string[] | undefined)?.join("; ") ?? "unknown";
  const prompt = buildHoldoutAuthorCharter({ task_id: taskId, task_title: task.title, prd_excerpt: c.prd_excerpt, design_review: c.design_review || "(S1 not written yet — derive from the PRD and goal; the pack may be re-authored at task design time)", goal: a?.goal ?? "(inactive)", project_hint: hint });
  const res = requestGeneric(root, cfg, "holdout-author", prompt, "NEMESIS_HOLDOUT_STUB");
  const dir = path.join(P.holdout(root), taskId);
  if (!res.result) { appendRecord(root, "holdout", { event: "author-failed", task: taskId, cause: res.cause, error: res.error }); return `NOT authored (${res.cause ?? "unavailable"}: ${res.error ?? "no result"}) — task end will refuse until a pack exists; rerun: nemesis task holdout ${taskId}`; }
  const r = res.result as { pack_id?: string; target?: string; deciding_case?: string; cases?: unknown[]; expected?: Record<string, unknown>; readme?: string };
  if (!Array.isArray(r.cases) || !r.cases.length || !r.expected) return "NOT authored (model returned no cases)";
  const pack = path.join(dir, "pack");
  fs.mkdirSync(pack, { recursive: true });
  fs.writeFileSync(path.join(pack, "cases.json"), JSON.stringify({ pack_id: r.pack_id ?? `HLD-${taskId}-0001`, target: r.target ?? task.title, candidate: { root: fs.existsSync(path.join(root, "src")) ? "src" : ".", files: ["**/*"] }, cases: r.cases }, null, 2));
  fs.writeFileSync(path.join(pack, "expected.json"), JSON.stringify(r.expected, null, 2));
  fs.writeFileSync(path.join(pack, "README.md"), r.readme ?? `Holdout for task ${taskId}\n`);
  const manifest = path.join(dir, "manifest.json");
  const seal = spawnSync(BUN, [HOLDOUT, "seal", pack, "--manifest", manifest, "--custodian", "nemesis daemon", ...(r.deciding_case ? ["--deciding", r.deciding_case] : [])], { encoding: "utf8" });
  if (seal.status !== 0) { appendRecord(root, "holdout", { event: "seal-failed", task: taskId, out: (seal.stderr || seal.stdout).slice(0, 500) }); return `authored but NOT sealed: ${(seal.stderr || seal.stdout).trim().split("\n").pop()}`; }
  appendRecord(root, "holdout", { event: "sealed", task: taskId, manifest: path.relative(root, manifest), cases: r.cases.length, deciding: r.deciding_case });
  return `sealed — ${r.cases.length} case(s), manifest .nemesis/holdout/${taskId}/manifest.json (pack withheld)`;
}

export function cmdTaskSketch(id: string, file: string, opts: { dir?: string }): void {
  const root = rootOrDie(opts.dir);
  if (!readTask(root, id)) die(`no task ${id}`);
  const text = fs.readFileSync(path.resolve(file), "utf8");
  const problems = validateSketch(text);
  if (problems.length) die(`threat sketch refused:\n  - ${problems.join("\n  - ")}`);
  const dst = path.join(P.task(root, id), "threat-sketch.yaml");
  fs.writeFileSync(dst, text);
  markStep(root, id, "S0", dst, "nemesis task sketch");
  const selected = (text.match(/checklists\s*:\s*\[([^\]]*)\]/)?.[1] ?? "").split(",").map((s) => s.trim().replace(/['"]/g, "")).filter(Boolean);
  const cl = readChecklists(root, id);
  for (const c of selected) cl[c] = { applies: true };
  writeChecklists(root, id, cl);
  appendRecord(root, "tasks", { event: "sketch", id, checklists: selected });
  ok(`S0 recorded for ${id} (checklists: ${selected.join(", ")}). Every other checklist needs: nemesis task checklist ${id} <3.x> na "<why>"\n  next: design review → nemesis task design ${id} <file>`);
}

export function cmdTaskDesign(id: string, file: string, opts: { dir?: string }): void {
  const root = rootOrDie(opts.dir);
  const cfg = readConfig(root);
  if (!readTask(root, id)) die(`no task ${id}`);
  const text = fs.readFileSync(path.resolve(file), "utf8");
  const problems = validateDesign(text);
  if (problems.length) die(`design review refused:\n  - ${problems.join("\n  - ")}`);
  const dst = path.join(P.task(root, id), "design-review.yaml");
  fs.writeFileSync(dst, text);
  markStep(root, id, "S1", dst, "nemesis task design");
  appendRecord(root, "tasks", { event: "design", id });
  // R-033: S1 exists now → the daemon authors and seals the task holdout from the PRD and S1
  const manifest = path.join(P.holdout(root), id, "manifest.json");
  const h = fs.existsSync(manifest) ? "already sealed (re-record the design with: nemesis task redesign <task> <issue> <file> for a new pack version)" : authorTaskHoldout(root, cfg, id);
  ok(`S1 recorded for ${id}. Edits to in-scope files are now allowed (and judged).\n  S7 holdout: ${h}`);
}

export function cmdTaskChecklist(id: string, cid: string, mode: string, why: string | undefined, opts: { dir?: string }): void {
  const root = rootOrDie(opts.dir);
  if (!readTask(root, id)) die(`no task ${id}`);
  if (!(CHECKLIST_IDS as readonly string[]).includes(cid)) die(`unknown checklist ${cid}`);
  const cl = readChecklists(root, id);
  let entry: ChecklistEntry;
  if (mode === "applies") entry = { applies: true };
  else if (mode === "na") { if (!why || why.trim().length < 8) die("n/a needs a real reason (8+ chars)"); entry = { applies: false, na_reason: why.trim() }; }
  else die("mode must be applies | na");
  cl[cid] = entry;
  writeChecklists(root, id, cl);
  ok(`checklist ${cid}: ${mode}${why ? " — " + why : ""}. Gaps left: ${checklistGaps(root, id).join(", ") || "none"}`);
}

function taskDiff(root: string, taskId: string): { diff: string; files: string[] } {
  const s2 = readSteps(root, taskId).entries.S2 as { items: { artifact?: string }[] };
  const files = new Set<string>();
  for (const it of s2.items) { try { files.add((JSON.parse(fs.readFileSync(path.resolve(root, it.artifact ?? ""), "utf8")) as { path: string }).path); } catch { /* skip */ } }
  for (const i of listIssues(root).filter((x) => x.task === taskId)) for (const f of i.files) files.add(f);
  const list = [...files];
  const git = spawnSync("git", ["rev-parse", "--is-inside-work-tree"], { cwd: root, encoding: "utf8" }).status === 0;
  let diff = "";
  if (git && list.length) {
    const d = spawnSync("git", ["diff", "HEAD", "--", ...list], { cwd: root, encoding: "utf8", maxBuffer: 64 * 1024 * 1024 });
    diff = d.stdout ?? "";
    const untracked = spawnSync("git", ["ls-files", "--others", "--exclude-standard", "--", ...list], { cwd: root, encoding: "utf8" }).stdout.split("\n").filter(Boolean);
    for (const u of untracked) diff += `\n=== new file ${u} ===\n${fs.existsSync(path.join(root, u)) ? fs.readFileSync(path.join(root, u), "utf8") : ""}`;
  }
  if (!diff) diff = list.map((f) => `=== ${f} ===\n${fs.existsSync(path.join(root, f)) ? fs.readFileSync(path.join(root, f), "utf8") : "(deleted)"}`).join("\n\n");
  return { diff, files: list };
}

function runReview(root: string, cfg: Config, taskId: string, focus?: Issue): { confirmed: boolean; findings: Finding[]; summary: string; failed?: string } {
  const task = readTask(root, taskId)!;
  const a = readActive(root);
  const { contractFor } = require("./lib/judge") as typeof import("./lib/judge");
  const c = contractFor(root, taskId, cfg);
  const { diff } = taskDiff(root, taskId);
  const prompt = buildReviewCharter({ task_id: taskId, task_title: task.title, threat_sketch: c.threat_sketch, design_review: c.design_review, diff, issues: listIssues(root).filter((i) => i.task === taskId), focus_issue: focus, contract_goal: a?.goal ?? "" });
  const res = requestGeneric(root, cfg, "review", prompt, "NEMESIS_REVIEW_STUB");
  const rec = path.join(P.records(root), taskId, focus ? `review-${focus.id}-${Date.now()}.json` : `review-${Date.now()}.json`);
  writeJson(rec, { at: nowIso(), task: taskId, focus: focus?.id, result: res.result, cause: res.cause, error: res.error, recovery: res.recovery });
  if (!res.result) return { confirmed: false, findings: [], summary: "", failed: `independent review unavailable (${res.cause ?? "no result"}: ${res.error ?? ""}) — not a pass` };
  const r = res.result as { confirmed_fixed?: boolean; findings?: Finding[]; summary?: string };
  const findings = (r.findings ?? []).map((f) => ({ ...f, lens: f.lens === "PFC" ? "PFC" : "PSC" } as Finding)).filter((f) => f.what);
  if (!focus) markStep(root, taskId, "S6", rec, "nemesis task end (independent review)", r.summary);
  return { confirmed: !!r.confirmed_fixed && findings.length === 0, findings, summary: r.summary ?? "" };
}

export function retryOpenIssuesAtTaskEnd(root: string, taskId: string): Issue[] {
  const open = listIssues(root, true).filter((i) => i.task === taskId);
  for (const i of open) { setPositionRung(root, i, 7, "task end with the issue open"); retryFromRung3(root, i); }
  return open;
}

export function cmdTaskEnd(id: string, opts: { dir?: string }): void {
  const root = rootOrDie(opts.dir);
  const cfg = readConfig(root);
  const task = readTask(root, id); if (!task) die(`no task ${id}`);
  if (task.status === "closed") { ok(`task ${id} already closed`); return; }
  const refuse = (why: string) => { appendRecord(root, "tasks", { event: "end-refused", id, why }); die(`task end refused — ${why}`); };
  // (1) S4: the latest two S3 scans clean
  const scans = listScans(root, id);
  const lastTwo = scans.slice(-2);
  if (lastTwo.length < 2 || !lastTwo.every((s) => s.clean)) refuse(`S4 needs the latest two S3 scans clean; have ${lastTwo.map((s) => (s.clean ? "clean" : "NOT clean (" + s.checks.filter((c) => c.status !== "pass").map((c) => c.id + ":" + c.status).join(",") + ")")).join(", ") || "none"}. Run: nemesis scan`);
  const s4 = path.join(P.records(root), id, `s4-${Date.now()}.json`);
  writeJson(s4, { at: nowIso(), task: id, clean_scans: lastTwo.map((s) => s.id) });
  markStep(root, id, "S4", s4, "nemesis task end");
  // (4) checklists
  const gaps = checklistGaps(root, id);
  if (gaps.length) refuse(`checklists neither ticked nor n/a'd: ${gaps.join(", ")}. Use: nemesis task checklist ${id} <3.x> na "<why>"`);
  // (2) S6 independent adversarial review
  const rev = runReview(root, cfg, id);
  if (rev.failed) refuse(rev.failed);
  if (rev.findings.length) {
    const issues = recordFindings(root, id, rev.findings, { verdict_id: "S6", files: rev.findings.map((f) => f.where.split(":")[0]!), outcome: "S6 review finding" });
    ok(`S6 review found ${rev.findings.length} issue(s): ${issues.map((i) => i.id).join(", ")}`);
  }
  // confirm fixes for issues awaiting review
  for (const i of listIssues(root, true).filter((x) => x.task === id && !x.review?.confirmed_fixed && x.repro)) {
    const fr = runReview(root, cfg, id, i);
    i.review = { at: nowIso(), by: "nemesis S6 (daemon)", confirmed_fixed: fr.confirmed, findings: fr.findings.map((f) => f.what) };
    i.history.push({ at: nowIso(), event: "reviewed", detail: fr.confirmed ? "confirmed fixed" : "NOT confirmed: " + (fr.failed ?? fr.summary) });
    writeIssue(root, i);
  }
  // (3) S7 holdout reveal in QA context
  const manifest = path.join(P.holdout(root), id, "manifest.json");
  if (!fs.existsSync(manifest)) refuse(`no sealed holdout for task ${id}; run: nemesis task holdout ${id}`);
  const already = readJson<{ reveal?: { verdict?: string } }>(manifest, {}).reveal?.verdict;
  if (!already) {
    const r = spawnSync(BUN, [HOLDOUT, "reveal", manifest, "--pack", path.join(P.holdout(root), id, "pack"), "--candidate", root, "--evidence", path.join(P.holdout(root), id, "evidence")], { cwd: root, encoding: "utf8", env: { ...process.env, HOLDOUT_QA_CONTEXT: "1" } });
    appendRecord(root, "holdout", { event: "reveal", task: id, status: r.status, out: (r.stdout + r.stderr).slice(-1500) });
    ok(r.stdout.trim().split("\n").slice(-6).join("\n"));
  }
  const verdict = readJson<{ reveal?: { verdict?: string } }>(manifest, {}).reveal?.verdict;
  markStep(root, id, "S7", manifest, "nemesis task end (holdout reveal)", verdict);
  if (verdict !== "PASS") {
    recordFindings(root, id, [{ severity: "high", lens: "PFC", checklist: "S7", where: `holdout ${id}`, what: `holdout verdict ${verdict ?? "none"} — acceptance behavior not proven`, fix_hint: "read .nemesis/holdout/" + id + "/evidence, fix, then author a NEW pack version: nemesis task holdout " + id + " --new" }], { verdict_id: "S7", files: [], outcome: "holdout" });
  }
  // (5) S5 record
  const open = listIssues(root, true).filter((i) => i.task === id);
  const all = listIssues(root).filter((i) => i.task === id);
  const record = [
    `task: ${id}`, `title: ${task.title}`, `threat_sketch: .nemesis/tasks/${id}/threat-sketch.yaml`, `design_review: .nemesis/tasks/${id}/design-review.yaml`,
    `issues: [${all.map((i) => `${i.id}:${i.status}`).join(", ")}]`,
    `scans: {${lastTwo[lastTwo.length - 1]!.checks.map((c) => `${c.id}: ${c.status}`).join(", ")}}`,
    `tests_added: {repro: ${all.filter((i) => i.repro).length}}`, `loop_passes: ${scans.length}`,
    `independent_review: {by: nemesis S6 daemon, findings: ${rev.findings.length}, summary: "${rev.summary.replace(/"/g, "'")}"}`,
    `holdout: {pack: .nemesis/holdout/${id}/manifest.json, verdict: ${verdict ?? "none"}}`,
    `residual_risks: [${open.map((i) => `{risk: "${i.what.replace(/"/g, "'")}", id: ${i.id}, rung: ${i.rung}}`).join(", ")}]`,
    `recorded_at: ${nowIso()}`,
  ].join("\n") + "\n";
  const rec = path.join(P.records(root), id, "check-record.yaml");
  fs.mkdirSync(path.dirname(rec), { recursive: true });
  fs.writeFileSync(rec, record);
  markStep(root, id, "S5", rec, "nemesis task end");
  // (6) close or rung 7
  const stillOpen = listIssues(root, true).filter((i) => i.task === id);
  if (stillOpen.length) {
    retryOpenIssuesAtTaskEnd(root, id);
    appendRecord(root, "tasks", { event: "end-open", id, open: stillOpen.map((i) => i.id) });
    ok(`task ${id} stays OPEN — ${stillOpen.length} issue(s) set to rung 7 → retry from rung 3 with full history:\n${stillOpen.map((i) => `  ${i.id}: ${rungInstruction(root, i)}`).join("\n")}`);
    process.exit(1);
  }
  const un = unfinishedSteps(root, id).filter((s) => !s.startsWith("S8"));
  if (un.length) refuse(`steps unfinished: ${un.join(", ")}`);
  task.status = "closed"; task.closed_at = nowIso(); writeTask(root, task);
  appendRecord(root, "tasks", { event: "closed", id });
  ok(`task ${id} CLOSED — record: ${path.relative(root, rec)}. S8 runs at goal end: nemesis release-gate`);
}

export function cmdTaskRedesign(taskId: string, issueId: string, file: string, opts: { dir?: string }): void {
  const root = rootOrDie(opts.dir);
  if (!readTask(root, taskId)) die(`no task ${taskId}`);
  const issue = readIssue(root, issueId); if (!issue) die(`no issue ${issueId}`);
  const text = fs.readFileSync(path.resolve(file), "utf8");
  const problems = validateDesign(text);
  if (problems.length) die(`design review refused:\n  - ${problems.join("\n  - ")}`);
  const dir = P.task(root, taskId);
  const prev = path.join(dir, "design-review.yaml");
  const versions = fs.readdirSync(dir).filter((f) => /^design-review\.v\d+\.yaml$/.test(f)).length + 1;
  if (fs.existsSync(prev)) fs.copyFileSync(prev, path.join(dir, `design-review.v${versions}.yaml`));
  fs.writeFileSync(prev, text);
  markStep(root, taskId, "S1", prev, `nemesis task redesign (issue ${issueId})`, `v${versions + 1}; v${versions} kept`);
  resetStep(root, taskId, "S2", "redesign"); resetStep(root, taskId, "S3", "redesign");
  // R-033: a new design → a new holdout pack version derived from it; the old manifest is kept as spent
  const manifest = path.join(P.holdout(root), taskId, "manifest.json");
  if (fs.existsSync(manifest)) fs.renameSync(manifest, manifest.replace(/\.json$/, `.spent-${Date.now()}.json`));
  const h = authorTaskHoldout(root, readConfig(root), taskId);
  appendRecord(root, "holdout", { event: "reauthored-on-redesign", task: taskId, result: h });
  issue.history.push({ at: nowIso(), event: "redesign", detail: `S1 v${versions + 1} recorded; S2/S3 reopened` });
  writeIssue(root, issue);
  appendRecord(root, "tasks", { event: "redesign", id: taskId, issue: issueId, version: versions + 1 });
  ok(`S1 v${versions + 1} recorded for ${taskId} (v${versions} kept). S2/S3 reopened — rebuild the feature from the new design.\n  S7 holdout (new version): ${h}`);
}

// ── issues ──────────────────────────────────────────────────────────────────

export function cmdIssue(sub: string, args: string[], raw: string[], opts: { dir?: string }): void {
  const root = rootOrDie(opts.dir);
  if (sub === "list") {
    const open = raw.includes("--open");
    const list = listIssues(root, open);
    if (!list.length) { ok(open ? "no open issues" : "no issues"); return; }
    for (const i of list) ok(`${i.id} [${i.severity}/${i.lens}/${i.checklist}] ${i.status} rung ${i.rung} task ${i.task} — ${i.what}`);
    return;
  }
  const id = args[0]; if (!id) die(`usage: issue ${sub} <id> …`);
  const i = readIssue(root, id); if (!i) die(`no issue ${id}`);
  if (sub === "show") { console.log(JSON.stringify(i, null, 2)); return; }
  if (sub === "history") { for (const h of i.history) ok(`${h.at} ${h.event}${h.detail ? ": " + h.detail : ""}`); return; }
  if (sub === "repro") {
    const [, file, ...nameParts] = args; const name = nameParts.join(" ");
    if (!file || !name) die("usage: issue repro <id> <testFile> <testName>");
    if (!fs.existsSync(path.resolve(root, file))) die(`test file not found: ${file}`);
    i.repro = { file, name, registered_at: nowIso() }; i.status = "verifying";
    i.history.push({ at: nowIso(), event: "repro", detail: `${file} :: ${name}` }); writeIssue(root, i);
    ok(`reproduction test registered on ${id}: ${file} :: ${name}. It is run with every S3 scan and must pass before close.`); return;
  }
  if (sub === "close") return cmdIssueClose(id, opts);
  if (sub === "decide") return cmdIssueDecide(id, raw, opts);
  die(`unknown issue command "${sub}" (list | show | history | repro | close | decide)`);
}

export function cmdIssueClose(id: string, opts: { dir?: string }): void {
  const root = rootOrDie(opts.dir);
  const i = readIssue(root, id); if (!i) die(`no issue ${id}`);
  if (!isOpen(i)) { ok(`${id} is already ${i.status}`); return; }
  const scans = listScans(root).map((s) => ({ clean: s.clean, tests_pass: s.tests_pass, repro_results: s.repro_results }));
  const missing = closureCheck(root, i, scans);
  if (missing.length) { appendRecord(root, "issues", { event: "close-refused", id, missing }); die(`close refused for ${id} — not yet proven fixed:\n  ${missing.join("\n  ")}`); }
  i.status = "closed"; i.closed_at = nowIso(); i.history.push({ at: nowIso(), event: "closed", detail: "repro test passing, suite passing, two clean scans, independent review confirmed" });
  writeIssue(root, i); appendRecord(root, "issues", { event: "closed", id });
  ok(`${id} CLOSED — proven: reproduction test passes, full suite passes, two clean S3 scans, independent review confirmed. The reproduction test stays.`);
}

export function cmdIssueDecide(id: string, args: string[], opts: { dir?: string }): void {
  const root = rootOrDie(opts.dir);
  const i = readIssue(root, id); if (!i) die(`no issue ${id}`);
  const choice = flag(args, "--choice") as "drop" | "change" | "accept" | undefined; const owner = flag(args, "--owner"); const note = flag(args, "--note"); const due = flag(args, "--due");
  if (!choice || !["drop", "change", "accept"].includes(choice)) die("--choice drop|change|accept is required");
  if (!owner) die("--owner <who> is required");
  if (i.rung < 8) die(`${id} is at rung ${i.rung}; a product decision is only asked at rung 8 (goal end). Run: nemesis release-gate`);
  i.decision = { at: nowIso(), choice, owner, note, due }; i.status = "decided";
  i.history.push({ at: nowIso(), event: "decided", detail: `${choice} by ${owner}${note ? ": " + note : ""}` });
  writeIssue(root, i); appendRecord(root, "issues", { event: "decided", id, choice, owner });
  ok(`${id} DECIDED: ${choice} by ${owner}. Recorded; the ledger no longer counts it as open.`);
}

export function cmdLadder(id: string, opts: { dir?: string }): void {
  const root = rootOrDie(opts.dir);
  const i = readIssue(root, id); if (!i) die(`no issue ${id}`);
  ok(`${id} — ${i.what}\nattempts: ${i.attempts.length}; current ${rungInstruction(root, i)}\n\nAll rungs:\n${RUNGS.map((r) => `  ${r.n === i.rung ? "→" : " "} ${r.n}. ${r.name} (${r.who})`).join("\n")}`);
}

export function cmdSecondOpinion(id: string, opts: { dir?: string }): void {
  const root = rootOrDie(opts.dir);
  const cfg = readConfig(root);
  const i = readIssue(root, id); if (!i) die(`no issue ${id}`);
  const provider = cfg.second_opinion_provider;
  const runner = path.join(ACOS_SCRIPTS(root), "run-external-agent.py");
  if (!provider || !fs.existsSync(runner)) {
    i.second_opinion = { at: nowIso(), provider: provider ?? "(none)", status: "unavailable" };
    i.history.push({ at: nowIso(), event: "second-opinion", detail: `rung4: unavailable (${provider ? "run-external-agent.py missing" : "no provider configured: set second_opinion_provider in .nemesis/config.json"})` });
    if (i.rung < 5) { i.rung = 5; i.history.push({ at: nowIso(), event: "rung", detail: "4 → 5 (second opinion unavailable; never silently skipped)" }); }
    writeIssue(root, i); appendRecord(root, "ladder", { issue: id, rung4: "unavailable" });
    ok(`rung 4 unavailable (${provider ? "runner missing" : "no provider configured"}) — recorded on ${id}; ladder proceeds to rung 5:\n  ${rungInstruction(root, i)}`); return;
  }
  const task = `Issue ${i.id} (${i.severity}, ${i.lens}, rule ${i.checklist}) at ${i.where}: ${i.what}\nRoot cause so far: ${i.root_cause ?? "unknown"}\nAttempts: ${i.attempts.map((a) => a.outcome).join(" | ")}\nGive (1) your independent analysis of the real cause, (2) a concrete patch as a unified diff, (3) the negative test that proves it. Output markdown.`;
  const r = spawnSync("python3", [runner, "--agent", "security-reviewer", "--model", provider, "--task", task, "--context", ...i.files.map((f) => path.join(root, f)).filter((f) => fs.existsSync(f))], { cwd: root, encoding: "utf8", maxBuffer: 32 * 1024 * 1024 });
  if (r.status !== 0) { i.second_opinion = { at: nowIso(), provider, status: "unavailable", analysis: (r.stderr || r.stdout).slice(0, 2000) }; i.history.push({ at: nowIso(), event: "second-opinion", detail: `provider ${provider} failed (exit ${r.status}); proceeding to rung 5` }); if (i.rung < 5) i.rung = 5; writeIssue(root, i); ok(`second opinion failed (exit ${r.status}); recorded; ladder proceeds to rung 5`); return; }
  const out = r.stdout;
  i.second_opinion = { at: nowIso(), provider, status: "received", analysis: out.slice(0, 20000), patch: out.match(/```diff\n([\s\S]*?)```/)?.[1] };
  i.history.push({ at: nowIso(), event: "second-opinion", detail: `received from ${provider}` }); writeIssue(root, i);
  appendRecord(root, "ladder", { issue: id, rung4: "received", provider });
  ok(`second opinion from ${provider} stored on ${id}${i.second_opinion.patch ? " (patch included)" : ""}. Have a Claude agent apply it; the edit is judged as any other.`);
}

export function cmdRevert(id: string, opts: { dir?: string }): void {
  const root = rootOrDie(opts.dir);
  const i = readIssue(root, id); if (!i) die(`no issue ${id}`);
  const files = i.files.length ? i.files : [i.where.split(":")[0]!];
  const r = restoreFromSnapshot(root, files);
  if (!r.restored.length) die(`nothing restored — no green snapshot holds ${files.join(", ")} (missing: ${r.missing.join(", ")})`);
  i.revert = { at: nowIso(), snapshot: r.restored[0]!.snapshot, files: r.restored.map((x) => x.file) };
  i.status = "reverted-open"; i.history.push({ at: nowIso(), event: "reverted", detail: `restored ${r.restored.map((x) => x.file).join(", ")} from ${r.restored[0]!.snapshot}` });
  writeIssue(root, i); appendRecord(root, "ladder", { issue: id, rung6: "reverted", files: i.revert.files });
  ok(`reverted ${r.restored.map((x) => x.file).join(", ")} to green snapshot ${r.restored[0]!.snapshot}. ${id} stays OPEN (reverted-open); it is retried at task end.${r.missing.length ? ` Not in any snapshot: ${r.missing.join(", ")}` : ""}`);
}

export function cmdReview(id: string, opts: { dir?: string }): void {
  const root = rootOrDie(opts.dir);
  const cfg = readConfig(root);
  const i = readIssue(root, id); if (!i) die(`no issue ${id}`);
  const fr = runReview(root, cfg, i.task, i);
  i.review = { at: nowIso(), by: "nemesis S6 (daemon)", confirmed_fixed: fr.confirmed, findings: fr.findings.map((f) => f.what) };
  i.history.push({ at: nowIso(), event: "reviewed", detail: fr.confirmed ? "confirmed fixed" : "NOT confirmed: " + (fr.failed ?? fr.summary) });
  writeIssue(root, i);
  if (fr.findings.length) recordFindings(root, i.task, fr.findings, { verdict_id: "review", files: i.files, outcome: "review finding" });
  ok(`review of ${id}: ${fr.confirmed ? "CONFIRMED fixed" : "NOT confirmed"} — ${fr.failed ?? fr.summary}`);
}

// ── release gate (S8) ───────────────────────────────────────────────────────

export function cmdReleaseGate(opts: { dir?: string }): void {
  const root = rootOrDie(opts.dir);
  const cfg = readConfig(root);
  const a = readActive(root);
  const open = listIssues(root, true);
  const refuse = (why: string) => { appendRecord(root, "release", { event: "refused", why }); die(`release gate CLOSED — ${why}`); };
  if (open.length) {
    // R-024: the goal-end gate found open issues → rung 8: every one goes to Zee as a product decision
    for (const i of open) if (i.rung < 8) setPositionRung(root, i, 8, "goal end with the issue open");
    const rep = writeReport(root, "product");
    appendRecord(root, "release", { event: "product-report", issues: open.map((i) => i.id), report: rep.md });
    refuse(`${open.length} open issue(s) at any severity (Low counts): ${open.map((i) => `${i.id}[${i.severity}]`).join(", ")} — all at rung 8 now. Product report for Zee: ${rep.html}. Record his pick: nemesis issue decide <id> --choice drop|change|accept --owner <who>`);
  }
  // R-034: ANY secret found during the work, at any severity and under any checklist, must have a rotation entry
  const SECRET_WORDS = /secret|credential|token|password|passwd|api[ _-]?key|private key|\.env\b|connection string/i;
  const secrets = listIssues(root).filter((i) => i.checklist.startsWith("3.4") || SECRET_WORDS.test(i.what));
  const rotations = readJson<Record<string, string>>(path.join(P.records(root), "secret-rotations.json"), {});
  const unrotated = secrets.filter((i) => !rotations[i.id]);
  if (unrotated.length) refuse(`secret(s) found during the work with no rotation recorded: ${unrotated.map((i) => i.id).join(", ")} — run: nemesis secret rotated <id> "<how>"`);
  const tasks = listTasks(root);
  const openTasks = tasks.filter((t) => t.status !== "closed");
  if (openTasks.length) refuse(`task(s) not closed: ${openTasks.map((t) => t.id).join(", ")}`);
  const holdouts = tasks.map((t) => readJson<{ reveal?: { verdict?: string } }>(path.join(P.holdout(root), t.id, "manifest.json"), {}).reveal?.verdict ?? "none");
  if (holdouts.some((h) => h !== "PASS")) refuse(`holdout verdicts not all PASS: ${holdouts.join(", ")}`);
  const checklist = readJson<Record<string, { status: string; note?: string }>>(P.releaseChecklist(root), {});
  const required = ["backups_restore_tested", "monitoring_alerts", "incident_contact", "secrets_rotated_if_exposed", "branch_protection"];
  const missing = required.filter((k) => !checklist[k] || !["done", "n/a"].includes(checklist[k]!.status) || (checklist[k]!.status === "n/a" && !(checklist[k]!.note ?? "").trim()));
  if (missing.length) refuse(`release checklist entries missing or without a note: ${missing.join(", ")} — write .nemesis/records/release-checklist.json {"<item>":{"status":"done"|"n/a","note":"…"}}`);
  const res = requestGeneric(root, cfg, "release", buildReleaseCharter({ goal: a?.goal ?? "", checklist, open_issues: 0, tasks_closed: true, holdouts }), "NEMESIS_RELEASE_STUB");
  if (!res.result) refuse(`S8 judgment unavailable (${res.cause ?? "no result"}) — not a pass`);
  const r = res.result as { gate?: string; findings?: Finding[]; summary?: string };
  if (r.gate !== "open" || (r.findings ?? []).length) {
    if (r.findings?.length) recordFindings(root, tasks[tasks.length - 1]?.id ?? "release", r.findings.map((f) => ({ ...f, lens: "PSC" as const })), { verdict_id: "S8", files: [], outcome: "release gate finding" });
    refuse(`S8 judge: ${r.summary ?? "gate closed"}${r.findings?.length ? " — " + r.findings.map((f) => f.what).join("; ") : ""}`);
  }
  writeJson(P.releaseGate(root), { at: nowIso(), gate: "open", goal: a?.goal, tasks: tasks.map((t) => t.id), holdouts, summary: r.summary });
  for (const t of tasks) markStep(root, t.id, "S8", P.releaseGate(root), "nemesis release-gate", r.summary);
  appendRecord(root, "release", { event: "open", summary: r.summary });
  ok(`release gate OPEN — ${r.summary ?? ""}\nAUTOPILOT_GOAL_COMPLETE is now accepted by the Stop hook (until the next change).`);
}

export function cmdSecretRotated(id: string, how: string, opts: { dir?: string }): void {
  const root = rootOrDie(opts.dir);
  if (!readIssue(root, id)) die(`no issue ${id}`);
  const p = path.join(P.records(root), "secret-rotations.json");
  const r = readJson<Record<string, string>>(p, {}); r[id] = `${nowIso()} ${how}`; writeJson(p, r);
  appendRecord(root, "release", { event: "secret-rotated", id, how });
  ok(`rotation recorded for ${id}`);
}

// ── scan / report / daemon / verdict-parse ──────────────────────────────────

export function cmdScan(opts: { dir?: string; judge?: string }): void {
  const root = rootOrDie(opts.dir);
  const cfg = readConfig(root);
  const task = currentTask(root);
  if (opts.judge) {
    const rel = isInScope(root, opts.judge, cfg).rel;
    const abs = path.join(root, rel); if (!fs.existsSync(abs)) die(`no such file ${rel}`);
    if (!task) die("no open task");
    const content = fs.readFileSync(abs, "utf8");
    const req = buildRequest(root, cfg, { rel, diff: `(manual judgment of the whole file ${rel})`, candidate: content, before_exists: true, source: "edit", taskId: task.id });
    requestVerdict(root, cfg, req).then((reply) => {
      if (reply.verdict.decision === "deny") { const issues = recordFindings(root, task.id, reply.verdict.findings, { verdict_id: req.id, files: [rel], outcome: "manual judge" }); ok(`DENY — ${issues.map((i) => i.id).join(", ")}\n${reply.verdict.findings.map((f) => `  ${f.checklist} ${f.where}: ${f.what}`).join("\n")}`); process.exit(1); }
      markStep(root, task.id, "S2", { inline: JSON.stringify({ path: rel, candidate_sha256: sha256(content), verdict_id: req.id, manual: true }), name: `s2-${req.id}.json` }, "nemesis scan --judge");
      ok(`ALLOW (${reply.layer}, ${reply.elapsed_ms}ms) — S2 recorded for ${rel}`);
    });
    return;
  }
  const repro = listIssues(root, true).filter((i) => i.repro).map((i) => i.repro!);
  const s = runScan(root, cfg, { trigger: "nemesis scan", changed: [], task: task?.id, repro });
  if (task) { markStep(root, task.id, "S3", path.relative(root, path.join(P.scans(root), `${s.id}.json`)), "nemesis scan", scanSummary(s)); if (s.clean) markStep(root, task.id, "PFC-c", path.relative(root, path.join(P.scans(root), `${s.id}.json`)), "nemesis scan (clean)"); }
  const f = scanFindings(s);
  if (task && f.length) recordFindings(root, task.id, f as Finding[], { verdict_id: s.id, files: [], outcome: "S3 scan finding" });
  for (const c of s.checks) ok(`${c.id.padEnd(10)} ${c.status.padEnd(8)} ${c.ms}ms${c.status !== "pass" ? "  " + c.output.split("\n").filter(Boolean).slice(-2).join(" | ").slice(0, 200) : ""}`);
  ok(isClean(s) ? "S3 clean" : `S3 NOT clean — ${f.length} finding(s) recorded`);
  if (!isClean(s)) process.exit(1);
  // R-022: every clean S3 advances the green state — snapshot what changed since the last index
  const t = refreshTreeIndex(root, cfg);
  const d = diffIndex(t.before, t.index);
  const files = [...d.changed, ...d.added];
  const snap = files.length ? writeGreenSnapshot(root, files, "clean S3 (nemesis scan)") : null;
  if (snap) ok(`green snapshot ${snap.id} — ${files.length} file(s)`);
}

export function cmdReport(opts: { dir?: string; product?: boolean; task?: string; open?: boolean }): void {
  const root = rootOrDie(opts.dir);
  const r = writeReport(root, opts.product ? "product" : "ledger", opts.task);
  ok(`report written:\n  ${r.md}\n  ${r.html}`);
  if (opts.open !== false) spawnSync("open", [r.html]);
}

export function cmdVerdictParse(file: string): void {
  const raw = file === "-" ? fs.readFileSync(0, "utf8") : fs.readFileSync(file, "utf8");
  const v = parseVerdict(raw) ?? parseVerdict(repairJson(raw));
  if (v) { ok(`readable: ${v.decision}, ${v.findings.length} finding(s)${v === parseVerdict(raw) ? "" : " (after repair_json)"}`); return; }
  const cls = classifyFailure(raw, "", 0);
  const plan = recoveryPlan(cls);
  ok(`unreadable — class: ${cls}\nrecovery plan: ${plan.map((p) => p.action).join(" → ")}\nif every step failed the daemon returns: ${finalDenial(cls, "(last error)", plan.map((p) => p.action)).reason}`);
}

// ── help ────────────────────────────────────────────────────────────────────

function help(): void {
  console.log(`nemesis — acos-nemesis-protocol (the rulebook's judge, riding along while code is written)

  enroll [dir] [--prd <file>]            install hooks + .nemesis/ in a project (idempotent)
  on "<goal>" [--prd <file>]             activate: judge every edit, scan every change, keep going
  off                                    deactivate (stops the loop only if Nemesis started it)
  status [--json]                        what is on, open issues, every task's 13 steps
  scope <path>                           in-scope or excluded (and why)

  task start <id> --title "…" [--prd-refs R-001,R-002]
  task sketch <id> <threat-sketch.yaml>  validate + record S0
  task design <id> <design-review.yaml>  validate + record S1 (edits become allowed)
  task checklist <id> <3.x> applies|na "<why>"
  task holdout <id> [--new]              (re)author + seal the acceptance holdout (daemon authors it)
  task end <id>                          S4 twice clean → S6 review → S7 reveal → S5 record → close or rung 7
  task redesign <id> <issue> <file>      rung 5: new S1 version, S2/S3 reopen

  issue list [--open] | show <id> | history <id>
  issue repro <id> <testFile> <testName> register the reproduction test
  issue close <id>                       only when proven (repro passes, suite passes, 2 clean scans, review)
  issue decide <id> --choice drop|change|accept --owner <who> [--note …]   rung 8 product decision
  ladder <id>                            current rung + instruction
  second-opinion <id>                    rung 4 via run-external-agent.py (records unavailable if no provider)
  revert <id>                            rung 6: restore files from the last green snapshot; issue stays open
  review <id>                            independent review of a fix (S6, daemon)

  release-gate                           S8; writes the record the Stop hook needs for goal-complete
  secret rotated <id> "<how>"            record a rotation for a found secret
  scan [--judge <file>]                  run S3 now (or judge one file by hand)
  report [--product] [--task <id>]       plain-language ledger (md + local html, opened)
  daemon status|start|stop|install       the judge daemon
  verdict-parse <file|->                 show how an unreadable reply is classified and recovered
  selftest                               attack every guarantee; exit non-zero on any failure
`);
}

if (import.meta.main) {
  const argv = process.argv.slice(2);
  const [cmd, ...rest] = argv;
  const dir = flag(rest, "--dir");
  try {
    switch (cmd) {
      case "enroll": cmdEnroll(positional(rest)[0], { prd: flag(rest, "--prd") }); break;
      case "scope": cmdScope(positional(rest)[0] ?? die("usage: scope <path>"), dir); break;
      case "on": cmdOn(positional(rest).join(" "), { prd: flag(rest, "--prd"), dir }); break;
      case "off": cmdOff({ dir }); break;
      case "status": cmdStatus({ dir, json: rest.includes("--json") }); break;
      case "task": {
        const [sub, id, ...more] = positional(rest);
        if (sub === "start") cmdTaskStart(id ?? die("task start <id>"), { title: flag(rest, "--title"), prdRefs: flag(rest, "--prd-refs")?.split(","), dir });
        else if (sub === "sketch") cmdTaskSketch(id!, more[0] ?? die("task sketch <id> <file>"), { dir });
        else if (sub === "design") cmdTaskDesign(id!, more[0] ?? die("task design <id> <file>"), { dir });
        else if (sub === "checklist") cmdTaskChecklist(id!, more[0]!, more[1]!, more.slice(2).join(" "), { dir });
        else if (sub === "holdout") { const root = rootOrDie(dir); if (rest.includes("--new")) { const m = path.join(P.holdout(root), id!, "manifest.json"); if (fs.existsSync(m)) fs.renameSync(m, m.replace(/\.json$/, `.spent-${Date.now()}.json`)); } ok(authorTaskHoldout(root, readConfig(root), id!)); }
        else if (sub === "end") cmdTaskEnd(id ?? die("task end <id>"), { dir });
        else if (sub === "redesign") cmdTaskRedesign(id!, more[0]!, more[1] ?? die("task redesign <task> <issue> <file>"), { dir });
        else die("task start|sketch|design|checklist|holdout|end|redesign");
        break;
      }
      case "issue": { const [sub, ...a] = positional(rest); cmdIssue(sub ?? "list", a, rest, { dir }); break; }
      case "ladder": cmdLadder(positional(rest)[0] ?? die("ladder <issue>"), { dir }); break;
      case "second-opinion": cmdSecondOpinion(positional(rest)[0] ?? die("second-opinion <issue>"), { dir }); break;
      case "revert": cmdRevert(positional(rest)[0] ?? die("revert <issue>"), { dir }); break;
      case "review": cmdReview(positional(rest)[0] ?? die("review <issue>"), { dir }); break;
      case "release-gate": cmdReleaseGate({ dir }); break;
      case "secret": { const [sub, id, ...how] = positional(rest); if (sub !== "rotated") die("secret rotated <id> \"<how>\""); cmdSecretRotated(id!, how.join(" "), { dir }); break; }
      case "scan": cmdScan({ dir, judge: flag(rest, "--judge") }); break;
      case "report": cmdReport({ dir, product: rest.includes("--product"), task: flag(rest, "--task"), open: !rest.includes("--no-open") }); break;
      case "daemon": { const sub = positional(rest)[0] ?? "status"; if (sub === "start") { startDaemon(); ok("daemon starting (see ~/.acos/nemesis/daemon.log)"); } else { const r = spawnSync(BUN, [path.join(SKILL_DIR, "scripts", "nemesis-daemon.ts"), sub], { encoding: "utf8", stdio: "inherit" }); process.exit(r.status ?? 1); } break; }
      case "verdict-parse": cmdVerdictParse(positional(rest)[0] ?? "-"); break;
      case "selftest": { const { runSelftest } = await import("./lib/selftest"); process.exit(await runSelftest(rest.includes("--verbose"))); }
      case "help": case undefined: case "--help": case "-h": help(); break;
      default: die(`unknown command "${cmd}" (nemesis help)`, 2);
    }
  } catch (e) { die(e instanceof Error ? e.message : String(e)); }
}
