#!/bin/bash

# ═══════════════════════════════════════════════════════════════════════════
# ACOS v3.0 - Command Line Interface (Native Claude Code Edition)
# ═══════════════════════════════════════════════════════════════════════════
#
# ACOS commands are now native Claude Code skills, discoverable in the /menu.
# This CLI is a thin wrapper for convenience.
#
# ═══════════════════════════════════════════════════════════════════════════

PURPLE='\033[0;35m'
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m'

ACOS_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BOOTSTRAP_SCRIPT="$ACOS_ROOT/.claude/scripts/acos-bootstrap.sh"

print_header() {
    echo -e "${PURPLE}"
    echo "═══════════════════════════════════════════════════════════════"
    echo "  ACOS v3.0 - Agentic Coding Orchestration System"
    echo "  Native Claude Code Edition"
    echo "═══════════════════════════════════════════════════════════════"
    echo -e "${NC}"
}

# ── Interactive skill menu ──────────────────────────────────────────────
# Shows skipped skills after bootstrap and lets user opt-in to extras.
# Reads the manifest written by acos-bootstrap.sh during skill selection.
show_skill_menu() {
    local MANIFEST=".acos/state/skipped-skills.txt"
    [[ ! -f "$MANIFEST" ]] && return 0

    local SKILL_COUNT
    SKILL_COUNT=$(wc -l < "$MANIFEST" | tr -d ' ')
    [[ "$SKILL_COUNT" -eq 0 ]] && return 0

    echo ""
    echo -e "${BOLD}  Additional Skills Available${NC}"
    echo -e "  ─────────────────────────────────────────────────────────"
    echo ""
    echo -e "  These skills were not auto-linked for this tech stack."
    echo -e "  Enter numbers to add (e.g. ${CYAN}1,3,5${NC}), ${CYAN}all${NC} for everything, or ${DIM}Enter${NC} to skip."
    echo ""

    local i=1
    local SKILL_NAMES=()
    while IFS='|' read -r name desc; do
        [[ -z "$name" ]] && continue
        SKILL_NAMES+=("$name")
        printf "  ${CYAN}%2d${NC}) ${BOLD}%-28s${NC} %s\n" "$i" "$name" "$desc"
        ((i++))
    done < "$MANIFEST"

    echo ""
    read -r -p "  Add skills [Enter to skip]: " SELECTION

    [[ -z "$SELECTION" ]] && {
        echo ""
        return 0
    }

    local LINKED=()

    if [[ "$SELECTION" == "all" ]]; then
        for name in "${SKILL_NAMES[@]}"; do
            local src="$ACOS_ROOT/.claude/skills/$name"
            local dest=".claude/skills/$name"
            if [[ -d "$src" && ! -e "$dest" ]]; then
                ln -s "$src" "$dest"
                LINKED+=("$name")
                echo -e "  ${GREEN}✓${NC} Linked $name"
            fi
        done
    else
        # Parse comma-separated numbers
        IFS=',' read -ra NUMS <<< "$SELECTION"
        for num in "${NUMS[@]}"; do
            num=$(echo "$num" | tr -d ' ')
            if [[ "$num" =~ ^[0-9]+$ ]] && (( num >= 1 && num <= ${#SKILL_NAMES[@]} )); then
                local name="${SKILL_NAMES[$((num-1))]}"
                local src="$ACOS_ROOT/.claude/skills/$name"
                local dest=".claude/skills/$name"
                if [[ -d "$src" && ! -e "$dest" ]]; then
                    ln -s "$src" "$dest"
                    LINKED+=("$name")
                    echo -e "  ${GREEN}✓${NC} Linked $name"
                elif [[ -e "$dest" ]]; then
                    echo -e "  ${DIM}·${NC} $name ${DIM}(already linked)${NC}"
                fi
            else
                echo -e "  ${YELLOW}⚠${NC} Invalid selection: $num"
            fi
        done
    fi

    # Append newly linked skills to .gitignore if any were added
    if [[ ${#LINKED[@]} -gt 0 && -f ".gitignore" ]]; then
        for skill in "${LINKED[@]}"; do
            if ! grep -qF ".claude/skills/$skill" ".gitignore" 2>/dev/null; then
                # Insert before "# End ACOS 3.0" marker if it exists
                if grep -qF "# End ACOS 3.0" ".gitignore" 2>/dev/null; then
                    sed -i '' "s|# End ACOS 3.0|.claude/skills/$skill\n# End ACOS 3.0|" ".gitignore"
                else
                    echo ".claude/skills/$skill" >> ".gitignore"
                fi
            fi
        done
    fi

    echo ""
}

# ── Handoff summary ─────────────────────────────────────────────────────
# Shows a brief summary of loaded handoffs so the user knows what context
# Claude will have when it starts.
show_handoff_summary() {
    local HANDOFF_DIR="memory/handoffs"
    [[ ! -d "$HANDOFF_DIR" ]] && return 0

    # Use Python to extract active/mechanical handoff summaries
    local SUMMARY
    SUMMARY=$(python3 - "$HANDOFF_DIR" <<'PYEOF'
import os, sys, glob

handoff_dir = sys.argv[1]
yaml_files = sorted(
    glob.glob(os.path.join(handoff_dir, '*.yaml')),
    key=lambda f: os.path.getmtime(f),
    reverse=True
)

entries = []
for fpath in yaml_files:
    status = 'active'
    summary = ''
    try:
        with open(fpath) as f:
            for line in f:
                line = line.strip()
                if line.startswith('status:'):
                    status = line.split(':', 1)[1].strip().strip('"').strip("'")
                if line.startswith('session_summary:'):
                    summary = line.split(':', 1)[1].strip().strip('"').strip("'")
    except Exception:
        continue

    if status in ('completed',):
        continue
    if summary:
        label = 'mechanical' if status == 'mechanical' else 'session'
        entries.append(f'{label}|{os.path.basename(fpath)}|{summary}')

for e in entries:
    print(e)
PYEOF
2>/dev/null)

    [[ -z "$SUMMARY" ]] && return 0

    echo ""
    echo -e "${BOLD}  Session Context${NC}"
    echo -e "  ─────────────────────────────────────────────────────────"

    local COUNT=0
    while IFS='|' read -r label filename desc; do
        [[ -z "$desc" ]] && continue
        if [[ "$label" == "mechanical" ]]; then
            echo -e "  ${DIM}⟳${NC} ${DIM}$desc${NC}"
        else
            echo -e "  ${CYAN}⟳${NC} $desc"
        fi
        ((COUNT++))
    done <<< "$SUMMARY"

    echo ""
    echo -e "  ${DIM}${COUNT} handoff(s) will be loaded into Claude's context${NC}"
    echo ""
}

case "${1:-help}" in
    start)
        print_header
        echo "Starting new ACOS session..."
        echo ""
        # Run bootstrap with --force to always pick up latest ACOS changes.
        # Bootstrap is fast and handles re-linking safely.
        if [[ -f "$BOOTSTRAP_SCRIPT" ]]; then
            bash "$BOOTSTRAP_SCRIPT" --force
            # Show what context Claude will have
            show_handoff_summary
            # Show interactive skill menu for skipped skills
            show_skill_menu
        else
            echo -e "${YELLOW}Warning: Bootstrap script not found at $BOOTSTRAP_SCRIPT${NC}"
        fi
        claude
        ;;
    resume)
        print_header
        echo "Resuming previous ACOS session..."
        echo ""
        # Force bootstrap on resume too — picks up latest ACOS changes quietly
        if [[ -f "$BOOTSTRAP_SCRIPT" ]]; then
            bash "$BOOTSTRAP_SCRIPT" --force --quiet
        fi
        show_handoff_summary
        claude --resume
        ;;
    help|--help|-h)
        print_header
        echo -e "Usage: ${CYAN}acos <command>${NC}"
        echo ""
        echo "Commands:"
        echo -e "  ${CYAN}start${NC}                  Start a new ACOS session"
        echo -e "  ${CYAN}resume${NC}                 Resume the previous session"
        echo -e "  ${CYAN}help${NC}                   Show this help message"
        echo ""
        echo "Once inside Claude Code, use these skills:"
        echo ""
        echo -e "  ${CYAN}/acos-start${NC}            Initialize and route project"
        echo -e "  ${CYAN}/acos-plan${NC}             Create planning documents"
        echo -e "  ${CYAN}/acos-execute-slice${NC}    Execute a slice"
        echo -e "  ${CYAN}/acos-execute-story${NC}    Execute a story"
        echo -e "  ${CYAN}/acos-execute-epic${NC}     Execute an epic"
        echo -e "  ${CYAN}/acos-complete-vision${NC}  Complete entire vision"
        echo -e "  ${CYAN}/acos-review${NC}           Trigger reviews"
        echo -e "  ${CYAN}/acos-status${NC}           View project status"
        echo -e "  ${CYAN}/acos-decide${NC}           Create ADR"
        echo -e "  ${CYAN}/acos-handoff-protocol${NC} Create session handoff"
        echo -e "  ${CYAN}/acos-learn${NC}            Extract learnings"
        echo -e "  ${CYAN}/acos-interview${NC}        Conduct vision interview"
        echo -e "  ${CYAN}/acos-oracle-protocol${NC}  Configure Oracle permissions"
        echo ""
        echo "Agents are in .claude/agents/ (auto-discovered)"
        echo "Skills are in .claude/skills/ (auto-discovered)"
        echo ""
        ;;
    *)
        echo "Unknown command: $1"
        echo "Run 'acos help' for available commands."
        echo ""
        echo "Most commands have moved to native Claude Code skills."
        echo "Start Claude Code and use /acos-* commands instead."
        exit 1
        ;;
esac
