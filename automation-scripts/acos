#!/bin/bash

# ═══════════════════════════════════════════════════════════════════════════
# ACOS v3.0 - Command Line Interface (Native Claude Code Edition)
# ═══════════════════════════════════════════════════════════════════════════
#
# ACOS commands are now native Claude Code skills, discoverable in the /menu.
# This CLI is a thin wrapper for convenience.
#
# ═══════════════════════════════════════════════════════════════════════════

PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

print_header() {
    echo -e "${PURPLE}"
    echo "═══════════════════════════════════════════════════════════════"
    echo "  ACOS v3.0 - Agentic Coding Orchestration System"
    echo "  Native Claude Code Edition"
    echo "═══════════════════════════════════════════════════════════════"
    echo -e "${NC}"
}

case "${1:-help}" in
    start)
        print_header
        echo "Starting new ACOS session..."
        echo ""
        # Fresh session — CLAUDE.md auto-loads at session start
        claude
        ;;
    resume)
        print_header
        echo "Resuming previous ACOS session..."
        echo ""
        # Resume the most recent conversation for this directory
        claude --resume
        ;;
    help|--help|-h)
        print_header
        echo -e "Usage: ${CYAN}acos <command>${NC}"
        echo ""
        echo "Commands:"
        echo -e "  ${CYAN}start${NC}                  Start a new ACOS session"
        echo -e "  ${CYAN}resume${NC}                 Resume the previous session"
        echo -e "  ${CYAN}help${NC}                   Show this help message"
        echo ""
        echo "Once inside Claude Code, use these skills:"
        echo ""
        echo -e "  ${CYAN}/acos-start${NC}            Initialize and route project"
        echo -e "  ${CYAN}/acos-plan${NC}             Create planning documents"
        echo -e "  ${CYAN}/acos-execute-slice${NC}    Execute a slice"
        echo -e "  ${CYAN}/acos-execute-story${NC}    Execute a story"
        echo -e "  ${CYAN}/acos-execute-epic${NC}     Execute an epic"
        echo -e "  ${CYAN}/acos-complete-vision${NC}  Complete entire vision"
        echo -e "  ${CYAN}/acos-review${NC}           Trigger reviews"
        echo -e "  ${CYAN}/acos-status${NC}           View project status"
        echo -e "  ${CYAN}/acos-decide${NC}           Create ADR"
        echo -e "  ${CYAN}/acos-handoff${NC}          Create session handoff"
        echo -e "  ${CYAN}/acos-learn${NC}            Extract learnings"
        echo -e "  ${CYAN}/acos-interview${NC}        Conduct vision interview"
        echo ""
        echo "Agents are in .claude/agents/ (auto-discovered)"
        echo "Skills are in .claude/skills/ (auto-discovered)"
        echo ""
        ;;
    *)
        echo "Unknown command: $1"
        echo "Run 'acos help' for available commands."
        echo ""
        echo "Most commands have moved to native Claude Code skills."
        echo "Start Claude Code and use /acos-* commands instead."
        exit 1
        ;;
esac
